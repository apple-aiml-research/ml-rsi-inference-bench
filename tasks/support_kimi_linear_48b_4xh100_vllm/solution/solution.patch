@@ -0,0 +1,124 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Graph-safe reset of recycled per-slot recurrent state.
+
+A state slot is recycled between requests. A row whose request has no valid
+history (no computed or restored tokens) must not consume the previous owner's
+convolution history or recurrent state. Prefill kernels handle this through
+``has_initial_state``; one-token decode kernels read the slot unconditionally.
+This kernel zeroes, inside the same (possibly captured) computation, every state
+component of such rows before the decode kernels consume them. It is launched
+unconditionally, and the per-row decision is read from device tensors, so a CUDA
+graph replay refreshes it from the staged metadata.
+"""
+
+import torch
+
+from vllm.attention.backends.utils import PAD_SLOT_ID
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _zero_slot_region(base_ptr, slot, slot_stride, numel, BLOCK: tl.constexpr):
+    offs = tl.arange(0, BLOCK)
+    row_ptr = base_ptr + slot * slot_stride
+    zeros = tl.zeros([BLOCK], dtype=base_ptr.dtype.element_ty)
+    for start in range(0, numel, BLOCK):
+        idx = start + offs
+        tl.store(row_ptr + idx, zeros, mask=idx < numel)
+
+
+@triton.jit
+def _reset_invalid_state_rows_kernel(
+    state_indices_ptr,
+    valid_ptr,
+    s0_ptr,
+    s1_ptr,
+    s2_ptr,
+    s3_ptr,
+    s0_stride,
+    s1_stride,
+    s2_stride,
+    s3_stride,
+    s0_numel,
+    s1_numel,
+    s2_numel,
+    s3_numel,
+    pad_slot_id: tl.constexpr,
+    NUM_STATES: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    slot = tl.load(state_indices_ptr + row).to(tl.int64)
+    # Inactive rows are masked before any destination address is formed: a
+    # padding sentinel is never mapped onto a real slot.
+    if (slot == pad_slot_id) | (slot < 0):
+        return
+    valid = tl.load(valid_ptr + row)
+    if valid:
+        return
+    _zero_slot_region(s0_ptr, slot, s0_stride, s0_numel, BLOCK)
+    if NUM_STATES > 1:
+        _zero_slot_region(s1_ptr, slot, s1_stride, s1_numel, BLOCK)
+    if NUM_STATES > 2:
+        _zero_slot_region(s2_ptr, slot, s2_stride, s2_numel, BLOCK)
+    if NUM_STATES > 3:
+        _zero_slot_region(s3_ptr, slot, s3_stride, s3_numel, BLOCK)
+
+
+def reset_invalid_state_rows(
+    state_tensors: tuple[torch.Tensor, ...] | list[torch.Tensor],
+    state_indices: torch.Tensor,
+    has_valid_state: torch.Tensor,
+    pad_slot_id: int = PAD_SLOT_ID,
+) -> None:
+    """Zero every state component of rows whose state is not valid.
+
+    Args:
+        state_tensors: up to four per-layer state tensors indexed by slot along
+            dim 0, each contiguous within a slot (the allocator's page layout:
+            ``stride(0)`` may exceed the slot's element count). Pass the
+            untransposed cache tensors.
+        state_indices: (rows,) slot index per row; ``pad_slot_id`` (or any
+            negative value) marks an inactive row, which is never written.
+        has_valid_state: (rows,) bool; True keeps the row's state unchanged.
+    """
+    assert 1 <= len(state_tensors) <= 4
+    assert state_indices.dim() == 1 and has_valid_state.dim() == 1
+    assert state_indices.shape[0] == has_valid_state.shape[0]
+    assert has_valid_state.dtype == torch.bool
+    rows = state_indices.shape[0]
+    if rows == 0:
+        return
+    ptrs, strides, numels = [], [], []
+    for t in state_tensors:
+        inner = t[0]
+        assert inner.is_contiguous(), "state must be contiguous within a slot"
+        ptrs.append(t)
+        strides.append(t.stride(0))
+        numels.append(inner.numel())
+    num_states = len(ptrs)
+    while len(ptrs) < 4:
+        ptrs.append(ptrs[0])
+        strides.append(strides[0])
+        numels.append(0)
+    _reset_invalid_state_rows_kernel[(rows,)](
+        state_indices,
+        has_valid_state,
+        ptrs[0],
+        ptrs[1],
+        ptrs[2],
+        ptrs[3],
+        strides[0],
+        strides[1],
+        strides[2],
+        strides[3],
+        numels[0],
+        numels[1],
+        numels[2],
+        numels[3],
+        pad_slot_id=pad_slot_id,
+        NUM_STATES=num_states,
+        BLOCK=1024,
+        num_warps=4,
+    )
