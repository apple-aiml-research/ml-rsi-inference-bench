+import unittest
+
+from test_gpt_oss_common import BaseTestGptOss
+
+
+class TestGptOss4Gpu(BaseTestGptOss):
+    def test_bf16_120b(self):
+        self.run_test(
+            model_variant="120b",
+            quantization="bf16",
+            expected_score_of_reasoning_effort={
+                "low": 0.61,
+                # remove to speed up
+                # "medium": 0.61,
+                # "high": 0.61,
+            },
+            other_args=["--tp", "4", "--cuda-graph-max-bs", "200"],
+        )
+
+    def test_mxfp4_120b(self):
+        self.run_test(
+            model_variant="120b",
+            quantization="mxfp4",
+            expected_score_of_reasoning_effort={
+                # The ADAPTED floor, re-measured on a reference whose chat endpoint renders the
+                # reasoning effort and returns the final channel (an earlier reference dropped the
+                # field, so an earlier floor of 112/198 had been measured at medium effort on the
+                # whole text). Five fresh runs on this verifier's own permutation seed at low effort
+                # scored 127, 133, 117, 133 and 124 of 198 (mean 0.640404, run-to-run sample sd
+                # 0.033955, binomial sd 0.034104); the minimum does not clear 0.61, so the rule's second
+                # branch applies: floor(mean - 3 sd) = 0.538537, floored to a whole question, is 106/198.
+                # Measured 2026-09-24; the scores and arithmetic are in tests/config.json infb.bars.
+                "low": 106 / 198,
+                # remove to speed up
+                # "medium": 0.61,
+                # "high": 0.61,
+            },
+            other_args=[
+                "--tp",
+                "4",
+                "--cuda-graph-max-bs",
+                "200",
+                "--mem-fraction-static",
+                "0.93",
+            ],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
