{
  "workloads": [
    {
      "name": "pd_multiturn",
      "input_len": 12000,
      "output_len": 512,
      "first_turn_prefix_tokens": 8000,
      "num_prompts": 64,
      "max_concurrency": 16,
      "_comment": "input_len is the tokens each TURN adds, not the prompt length. The conversation starts at 8000 tokens and every turn appends this many plus the reply, so by turn 8 the prompt is ~58048 tokens. Feeding input_len to --random-input-len benches a 5x smaller shape than the one this task scores.",
      "profiles": [
        {
          "name": "c4",
          "pattern": "closed_loop",
          "concurrency": 4
        },
        {
          "name": "c8",
          "pattern": "closed_loop",
          "concurrency": 8
        },
        {
          "name": "c16",
          "pattern": "closed_loop",
          "concurrency": 16
        }
      ]
    }
  ],
  "pd": {
    "chunked_prefill_size": 8192,
    "context_window": 1000000,
    "conversation_turns": 8,
    "conversations": 16,
    "decode_gpus": 4,
    "discovery_port": 30001,
    "engine": "sglang",
    "engine_argv_template": [
      "{python}",
      "-m",
      "sglang.launch_server",
      "--model-path",
      "{model}",
      "--host",
      "0.0.0.0",
      "--tp-size",
      "{width}",
      "--served-model-name",
      "{served}",
      "--trust-remote-code",
      "--random-seed",
      "1024",
      "--context-length",
      "{max_len}",
      "--max-running-requests",
      "256",
      "--chunked-prefill-size",
      "{chunked_prefill_size}",
      "--dtype",
      "bfloat16",
      "--moe-runner-backend",
      "flashinfer_mxfp4"
    ],
    "first_turn_prefix_tokens": 8000,
    "new_tokens_per_turn": 12000,
    "prefill_gpus": 4,
    "reply_tokens": 512,
    "router_port": 10001,
    "transfer_backend": "nixl"
  }
}
