{
 "schema": "infb-m3-chat-examples/1",
 "note": "Public examples for `run.py chat` and `run.py tools`; grading uses other prompts of the same kinds (two per thinking mode; a single call, two invokes in one call block, a second turn after a tool result, and a call with thinking enabled), each non-streaming and streaming, greedy, 2,048 tokens.",
 "reasoning": [
