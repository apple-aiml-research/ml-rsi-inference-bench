   "messages": [
    {
     "role": "user",
     "content": "Name the largest planet."
    }
   ]
  },
  {
   "id": "example-adaptive",
   "thinking_mode": "adaptive",
   "messages": [
    {
     "role": "user",
     "content": "How many minutes are in 3 hours?"
    }
   ]
  }
 ],
