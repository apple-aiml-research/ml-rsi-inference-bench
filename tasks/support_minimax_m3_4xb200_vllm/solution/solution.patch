+            tma_load_op,
+            q_tma_tensor,
+            q_smem_layout_stage,
+            self.mma_tiler,
+            tiled_mma,
+            cluster_layout_vmnk.shape,
+        )
+        tma_k = cute.nvgpu.make_tiled_tma_atom_B(
+            tma_load_op,
+            k_tma_tensor,
+            k_smem_layout_stage,
