+        cvt_f16x2_to_bf16x2(f16_pair0, loc=loc, ip=ip),
+        cvt_f16x2_to_bf16x2(f16_pair1, loc=loc, ip=ip),
+        cvt_f16x2_to_bf16x2(f16_pair2, loc=loc, ip=ip),
+        cvt_f16x2_to_bf16x2(f16_pair3, loc=loc, ip=ip),
+    )
+
