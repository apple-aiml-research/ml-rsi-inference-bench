+        "cu_seqlens_k": torch.tensor(_exclusive_prefix(k_lengths), dtype=torch.int32, device=device),
+        "cu_page_offsets": torch.tensor(_exclusive_prefix(pages_per_batch), dtype=torch.int32, device=device),
