+
+
+@dsl_user_op
+def stg_64_bf16(
+    gmem_ptr: cute.Pointer,
+    v0: Float32,
+    v1: Float32,
+    v2: Float32,
+    v3: Float32,
+    *,
+    loc=None,
+    ip=None,
+):
+    llvm.inline_asm(
+        llvm.StructType.get_literal([T.f32(), T.f32(), T.f32(), T.f32()]),
+        [
+            gmem_ptr.toint().ir_value(loc=loc, ip=ip),
