+        src_i32 = cute.recast_tensor(src, cutlass.Int32)
+        dst_i32 = cute.recast_tensor(dst, cutlass.Int32)
+        for word_idx in cutlass.range_constexpr(4):
+            (
+                dst_i32[word_idx * 2],
+                dst_i32[word_idx * 2 + 1],
+            ) = utils.cvt_fp8x4_e4m3_bf16x4(src_i32[word_idx])
