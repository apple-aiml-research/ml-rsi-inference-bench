+
+SHELL := /bin/bash
+.DEFAULT_GOAL := help
+
+PYTHON ?= python
+PIP ?= pip
+PYTEST ?= $(PYTHON) -m pytest
+
+TEST_FILE := test_sparse_atten.py
+PROFILE_DIR := profiles/ncu
+NCU_OUT ?= $(PROFILE_DIR)/sparse_atten
+
+# Customer benchmark defaults
+B ?= 1
+SQ ?= 32768
+SKV ?= 32768
+TOPK ?= 16
+HEAD_KV ?= 4
+QHEAD_PER_KV ?= 16
+DIM ?= 128
+BLK_KV ?= 128
+WARMUP ?= 5
+ITERS ?= 20
+SEED ?= 42
+
+# Benchmark toggles
+BACKEND ?= cute
+CUSTOMER_CASE ?= manual
+Q2K_PATTERN ?= sink
+PAGED ?= 0
+DTYPE ?= bf16
+PARTIAL_DTYPE ?= fp32
+CAUSAL ?= 1
+PAGE_SIZE ?= $(BLK_KV)
