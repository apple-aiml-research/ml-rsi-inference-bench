+CUSTOMER_QHEAD_SWEEP_CASES = {
+    f"qhead{qhead}": {
+        "name": f"bs1_nhq{qhead}_hkv1_seq{(768 // qhead)}k_qhead_sweep",
+        "batch": 1,
+        "seqlen_q": 768 * 1024 // qhead,
