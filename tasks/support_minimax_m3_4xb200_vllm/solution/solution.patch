+                sVFp4,
+                mVScale,
+                mVGlobalScale,
+                sPagedKvIdx,
+                sV,
+                lane,
+                warp_idx_in_wg,
+                num_dequant_warps,
+                head_kv_idx,
+                kv_block_idx,
+                k_batch_offset,
+                num_heads_kv,
+            )
+            dequant_barrier.arrive_and_wait()
+            if warp_idx_in_wg == Int32(0):
+                with cute.arch.elect_one():
+                    cute.arch.mbarrier_arrive(mbar_v_ptr)
