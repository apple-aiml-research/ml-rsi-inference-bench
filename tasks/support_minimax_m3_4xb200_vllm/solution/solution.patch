diff --git a/minimax_m3_msa.py b/minimax_m3_msa.py
new file mode 100644
index 0000000000000000000000000000000000000000..ab94a7734491ff466ae928022d3ccb0a5661ec34
--- /dev/null
+++ b/minimax_m3_msa.py
@@ -0,0 +1,108 @@
+# SPDX-License-Identifier: Apache-2.0
+"""MiniMax Sparse Attention operator contract, served by this tree's own kernels.
+
+The six entry points of the contract (``/app/eval/minimax_m3/msa/README.md``) over the kernels this engine serves
+MiniMax-M3 with on SM100, called exactly as the served attention backend calls them:
+
+  * caches: the main paged K/V cache ``[pages, 2, 128, 1, 128]`` (K = ``[:, 0]``, V = ``[:, 1]``, one KV head per
+    rank) in the KV-cache dtype, and the key-only index cache ``[pages, 128, 128]`` in BF16;
+  * ``select_prefill``: the indexer's prefill block scoring then top-k selection (16 blocks, the query's own block
+    forced, no forced first block);
+  * ``select_decode``: the indexer's fused decode scoring and top-k;
+  * ``attend_prefill``: the SM100 sparse prefill attention (CSR build, then the sparse attention function);
+  * ``attend_decode``: the split-K sparse decode attention.
+
+Selections are returned as the single index head's ``[T, 16]`` slice of the engine's ``[1, T, 16]`` selection.
+"""
+
+from __future__ import annotations
+
+import math
+
+import torch
+
+from vllm.models.minimax_m3.common.ops.index_topk import (
+    minimax_m3_index_decode,
+    minimax_m3_index_score,
+    minimax_m3_index_topk,
+)
+from vllm.models.minimax_m3.common.ops.sparse_attn import (
+    SPARSE_BLOCK_SIZE,
+    minimax_m3_sparse_attn_decode,
+)
+
+HEAD_DIM = 128
+NUM_HEADS = 16  # query heads of the one GQA group a rank holds at TP4
+TOPK = 16
+SCALE = 1.0 / math.sqrt(HEAD_DIM)
+
+
+class _Cache:
+    __slots__ = ("kv", "index", "kv_dtype")
+
+    def __init__(self, kv: torch.Tensor, index: torch.Tensor, kv_dtype: torch.dtype) -> None:
+        self.kv, self.index, self.kv_dtype = kv, index, kv_dtype
+
+
+def create_cache(num_pages: int, kv_dtype: torch.dtype, device) -> _Cache:
+    if kv_dtype not in (torch.bfloat16, torch.float8_e4m3fn):
+        raise ValueError(f"unsupported KV dtype {kv_dtype}")
+    kv = torch.zeros((num_pages, 2, SPARSE_BLOCK_SIZE, 1, HEAD_DIM), dtype=kv_dtype, device=device)
+    index = torch.zeros((num_pages, SPARSE_BLOCK_SIZE, HEAD_DIM), dtype=torch.bfloat16, device=device)
+    return _Cache(kv, index, kv_dtype)
+
+
+def cache_views(cache: _Cache) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    return cache.kv[:, 0, :, 0, :], cache.kv[:, 1, :, 0, :], cache.index
+
+
+def _max(t: torch.Tensor) -> int:
+    return int(t.max().item()) if t.numel() else 0
+
+
+def select_prefill(cache, index_q, block_table, query_start_loc, seq_lens, context_lens) -> torch.Tensor:
+    q_lens = query_start_loc[1:] - query_start_loc[:-1]
+    max_q, max_s = _max(q_lens), _max(seq_lens)
+    score = minimax_m3_index_score(
+        index_q.view(-1, 1, HEAD_DIM), cache.index, block_table, query_start_loc, seq_lens, context_lens,
+        max_q, max_s, 1, SCALE,
+    )
+    topk = minimax_m3_index_topk(score, query_start_loc, context_lens, max_q, TOPK, 0, 1)
+    return topk[0]
+
+
+def select_decode(cache, index_q, block_table, seq_lens) -> torch.Tensor:
+    topk = minimax_m3_index_decode(
+        index_q.view(-1, 1, HEAD_DIM), cache.index, block_table, seq_lens, _max(seq_lens), TOPK, 0, 1, 1, SCALE, 1,
+    )
+    return topk[0]
+
+
+def attend_prefill(cache, q, selection, block_table, query_start_loc, seq_lens, context_lens) -> torch.Tensor:
+    from vllm.third_party.fmha_sm100.sparse import build_k2q_csr, sparse_atten_func
+
+    q_lens = query_start_loc[1:] - query_start_loc[:-1]
+    max_q, max_s = _max(q_lens), _max(seq_lens)
+    cu_seqlens_k = torch.zeros(seq_lens.numel() + 1, dtype=torch.int32, device=seq_lens.device)
+    torch.cumsum(seq_lens, dim=0, out=cu_seqlens_k[1:])
+    total_rows = int(((seq_lens + SPARSE_BLOCK_SIZE - 1) // SPARSE_BLOCK_SIZE).sum().item())
+    out = torch.empty((q.shape[0], NUM_HEADS, HEAD_DIM), dtype=torch.bfloat16, device=q.device)
+    k_cache = cache.kv[:, 0].transpose(1, 2)
+    v_cache = cache.kv[:, 1].transpose(1, 2)
+    k2q_row_ptr, k2q_q_indices, schedule = build_k2q_csr(
+        selection.unsqueeze(0), query_start_loc, cu_seqlens_k, SPARSE_BLOCK_SIZE, total_k=0,
+        max_seqlen_k=max_s, max_seqlen_q=max_q, total_rows=total_rows, qhead_per_kv=NUM_HEADS,
+        return_schedule=True,
+    )
+    sparse_atten_func(
+        q, k_cache, v_cache, k2q_row_ptr, k2q_q_indices, topK=TOPK, blk_kv=SPARSE_BLOCK_SIZE, causal=True,
+        softmax_scale=SCALE, cu_seqlens_q=query_start_loc, cu_seqlens_k=cu_seqlens_k, max_seqlen_q=max_q,
+        max_seqlen_k=max_s, page_table=block_table, seqused_k=seq_lens, schedule=schedule, out=out,
+    )
+    return out
+
+
+def attend_decode(cache, q, selection, block_table, seq_lens) -> torch.Tensor:
+    out = torch.empty((q.shape[0], NUM_HEADS, HEAD_DIM), dtype=torch.bfloat16, device=q.device)
+    minimax_m3_sparse_attn_decode(q, cache.kv, selection.unsqueeze(0), block_table, seq_lens, 1, SCALE, out, 1)
+    return out
