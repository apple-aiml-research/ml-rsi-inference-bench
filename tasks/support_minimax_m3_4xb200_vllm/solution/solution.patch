+
+@contextmanager
+def _nvtx_range(message: str):
+    torch.cuda.nvtx.range_push(message)
+    try:
+        yield
+    finally:
+        torch.cuda.nvtx.range_pop()
+
+
+def _nvtx_token(text: object) -> str:
+    return "".join(ch if ch.isalnum() or ch == "_" else "_" for ch in str(text))
