+_SPARSE_MQA_API = (
+    "get_sparse_mqa_logits_metadata",
+    "get_paged_sparse_mqa_logits_metadata",
+    "fp8_fp4_sparse_mqa_logits",
+    "fp8_fp4_paged_sparse_mqa_logits",
+)
+_sparse_mqa_impls: dict[str, Callable[..., Any]] | None = None
+
+
+def _sparse_mqa_init() -> dict[str, Callable[..., Any]]:
+    global _sparse_mqa_impls
+    if _sparse_mqa_impls is not None:
+        return _sparse_mqa_impls
+    impls: dict[str, Callable[..., Any]] = {}
+    if current_platform.is_cuda():
