+        if not os.environ.get(cache_env, None):
+            os.environ[cache_env] = os.path.join(
+                envs.VLLM_CACHE_ROOT, "deep_gemm_v41_sparse"
+            )
+        try:
+            module = importlib.import_module("vllm.third_party.deep_gemm_v41_sparse")
+        except Exception as e:  # noqa: BLE001
+            logger.warning_once("The sparse MQA-logits runtime is unavailable: %s", e)
+        else:
+            impls = {
+                name: fn
+                for name in _SPARSE_MQA_API
+                if (fn := getattr(module, name, None)) is not None
+            }
+    _sparse_mqa_impls = impls
+    return impls
+
+
+def has_deep_gemm_sparse_mqa() -> bool:
+    """Whether the sparse-indexer runtime provides the sparse MQA-logits
+    kernels (``fp8_fp4_(paged_)sparse_mqa_logits``, SM100-only)."""
+    return all(name in _sparse_mqa_init() for name in _SPARSE_MQA_API)
+
+
+def get_sparse_mqa_logits_metadata(
+    cu_seqlen_ks: torch.Tensor,
+    cu_seqlen_ke: torch.Tensor,
+    num_kv_tokens: int,
+    sparse_kv_block_indices: torch.Tensor,
+    qk_dtype: torch.dtype,
+    sparse_block_kv: int,
