@@ -0,0 +1,258 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Request cancellation: which requests have been aborted, and the check the denoising loop makes at every step.
+
+An abort reaches the rank-0 scheduler as an AbortReq, through the same socket as every request. While a request is being
+denoised the scheduler is inside that request's forward, so it installs a poller here, and the rank-0 worker polls its
+socket at every step boundary: an AbortReq for the running request is marked and answered on the spot; anything else
+that arrived meanwhile (an abort for another request included) is kept for the event loop, which hands it to every rank.
+The abort can name the running request, a queued one (the scheduler drops it), or one not seen yet (kept for
+ABORT_TTL_S, so a request that arrives just after its own abort is dropped too).
+
+A request also stops when its deadline passes (`deadline_epoch` in its `extra`, set from the `timeout_s` sampling
+parameter when the request is prepared).
+
+The DECISION to stop is rank 0's, and it is broadcast to every rank of the world group at every step, so all ranks raise
+RequestAborted at the same step: a rank that stopped alone would leave the others waiting in the next collective.
+"""
+
+from __future__ import annotations
+
+import time
+from contextlib import contextmanager
+from typing import Any, Callable
+
+from sglang.multimodal_gen.runtime.utils.logging_utils import init_logger
+
+logger = init_logger(__name__)
+
+#: how long an abort for a request the scheduler has not seen stays armed
+ABORT_TTL_S = 60.0
+#: every stop this module causes carries PREFIX, whatever wrapper embeds its message (a stable signal for callers), and
+#: the reason says which: CLIENT (an abort) or DEADLINE (its timeout_s passed)
+PREFIX = "RequestAborted: "
+CLIENT = "aborted by the client"
+DEADLINE = "deadline passed"
+#: a generation request whose caller-chosen request_id is already running or queued is refused with this prefix
+DUPLICATE_PREFIX = "DuplicateRequestId: "
+
+
+def classify(text: Any) -> str | None:
+    """'deadline' or 'client' for an error text carrying PREFIX, 'duplicate' for DUPLICATE_PREFIX, else None."""
+    t = str(text or "")
+    if DUPLICATE_PREFIX.strip() in t:
+        return "duplicate"
+    if PREFIX.strip() not in t:
+        return None
+    return "deadline" if DEADLINE in t.split(PREFIX.strip(), 1)[1] else "client"
+
+
+class RequestAborted(RuntimeError):
+    """The client aborted the request, or its deadline passed; raised on every rank at one step boundary."""
+
+
+class SynchronizedBatchError(RuntimeError):
+    """All live ranks reached the same boundary and agreed on the failure.
+
+    A failed process group is not safe to retry inside this worker. Ordinary
+    stage errors may be isolated with bounded singleton retries, once every
+    rank has left the failed stage. The supervisor owns worker replacement.
+    """
+    def __init__(self, message: str, retry_safe: bool = False):
+        super().__init__(message)
+        self.retry_safe = retry_safe
+
+
+_batch_group_failure: str | None = None
+
+
+def check_batch_group() -> None:
+    if _batch_group_failure is not None:
+        raise SynchronizedBatchError(_batch_group_failure, retry_safe=False)
+
+
+def gather_status(value: Any, boundary: str = "SD3 worker result") -> list[Any]:
+    """Small CPU control messages only; never gather model outputs here."""
+    global _batch_group_failure
+    check_batch_group()
+    world = _world()
+    if world is None or world[1] <= 1:
+        return [value]
+    import torch.distributed as dist
+    values = [None] * world[1]
+    try:
+        dist.all_gather_object(values, {"boundary": boundary, "value": value}, group=world[2])
+    except Exception as exc:
+        _batch_group_failure = f"SD3 control group failed: {exc}"
+        raise SynchronizedBatchError(_batch_group_failure, retry_safe=False) from exc
+    labels = [entry["boundary"] for entry in values]
+    if any(label != boundary for label in labels):
+        _batch_group_failure = f"SD3 ranks reached different boundaries: {labels}"
+        raise SynchronizedBatchError(_batch_group_failure, retry_safe=False)
+    return [entry["value"] for entry in values]
+
+
+@contextmanager
+def synchronize_errors(enabled: bool, boundary: str):
+    """For opt-in TP batching, do not enter the next stage/CFG branch alone.
+
+    This does not repair a failed NCCL/Gloo communicator. An error *inside* a
+    collective still obeys its configured process-group timeout; all ranks
+    that can return report failure, and no singleton retry reuses that group.
+    """
+    global _batch_group_failure
+    if not enabled:
+        yield
+        return
+    check_batch_group()
+    import torch.distributed as dist
+    error = None
+    try:
+        yield
+    except Exception as exc:
+        error = exc
+    status = None if error is None else {
+        "message": f"{type(error).__name__}: {error}",
+        "aborted": isinstance(error, RequestAborted),
+        "retry_safe": (getattr(error, "retry_safe", True)
+                       and not isinstance(error, dist.DistError)),
+    }
+    failures = [(rank, entry) for rank, entry in enumerate(gather_status(status, boundary)) if entry is not None]
+    if failures:
+        message = f"{boundary}: " + "; ".join(f"rank {rank}: {entry['message']}" for rank, entry in failures)
+        if all(entry["aborted"] for _, entry in failures):
+            raise RequestAborted(message) from error
+        retry_safe = all(entry["retry_safe"] for _, entry in failures)
+        if not retry_safe:
+            _batch_group_failure = message
+        raise SynchronizedBatchError(message, retry_safe=retry_safe) from error
+
+
+# request_id -> (reason, expiry epoch or None while the request is known to the scheduler)
+_aborted: dict[str, tuple[str, float | None]] = {}
+_poller: Callable[[], None] | None = None
+
+
+def install_poller(fn: Callable[[], None] | None) -> None:
+    """The scheduler's socket poller, called on rank 0 at every step boundary (None uninstalls it)."""
+    global _poller
+    _poller = fn
+
+
+def mark(request_id: str, reason: str, ttl_s: float | None = None) -> None:
+    """Arm an abort for `request_id`: until cleared, or for `ttl_s` seconds when the request is not known yet."""
+    _aborted[str(request_id)] = (reason, None if ttl_s is None else time.time() + ttl_s)
+
+
+def clear(request_id: str | None) -> None:
+    if request_id is not None:
+        _aborted.pop(str(request_id), None)
+
+
+def aborted_reason(request_id: str | None) -> str | None:
+    """The reason `request_id` was aborted, or None. An expired not-yet-seen abort is dropped."""
+    if request_id is None:
+        return None
+    entry = _aborted.get(str(request_id))
+    if entry is None:
+        return None
+    reason, expiry = entry
+    if expiry is not None and time.time() > expiry:
+        _aborted.pop(str(request_id), None)
+        return None
+    return reason
+
+
+def request_ids(batch: Any) -> list[str]:
+    """The ids of the requests a batch serves: every merged request's (dynamic batching), else its own."""
+    extra = getattr(batch, "extra", None) or {}
+    merged = extra.get("merged_request_ids")
+    if merged:
+        return [str(i) for i in merged]
+    rid = getattr(batch, "request_id", None)
+    return [str(rid)] if rid is not None else []
+
+
+def deadline_reason(batch: Any, now: float | None = None) -> str | None:
+    extra = getattr(batch, "extra", None) or {}
+    deadline = extra.get("deadline_epoch")
+    if deadline is None:
+        return None
+    now = time.time() if now is None else now
+    if now > float(deadline):
+        return f"its {DEADLINE} {now - float(deadline):.2f}s ago (timeout_s)"
+    return None
+
+
+def local_reason(batch: Any) -> str | None:
+    """Rank 0's view: poll for aborts, then check members and deadlines.
+    An SD3 merged batch stops at the next step if any member has stopped;
+    its surviving members restart from their own original inputs and seeds.
+    """
+    if _poller is not None:
+        try:
+            _poller()
+        except Exception as exc:  # noqa: BLE001 - a poller failure must not fail the request it is polling for
+            logger.warning(f"abort poller failed: {exc}")
+    members = (getattr(batch, "extra", None) or {}).get("sd3_batch_members")
+    if members:
+        # Stop the shared forward on any member's cancellation/deadline. The
+        # worker retries survivors from their original inputs and seed, after
+        # every rank has left the same step boundary.
+        now = time.time()
+        for member in members:
+            reason = aborted_reason(member["request_id"])
+            deadline = member.get("deadline_epoch")
+            if reason:
+                return reason
+            if deadline is not None and now > float(deadline):
+                return f"its {DEADLINE} {now-float(deadline):.2f}s ago (timeout_s)"
+        return None
+    ids = request_ids(batch)
+    reasons = [aborted_reason(i) for i in ids]
+    if ids and all(reasons):
+        return reasons[0]
+    return deadline_reason(batch)
+
+
+def _world():
+    """(rank, world size, CPU group) of the world group, or None when no process group is set up."""
+    try:
+        from sglang.multimodal_gen.runtime.distributed.parallel_state import get_world_group
+
+        w = get_world_group()
+        return w.rank, w.world_size, w.cpu_group
+    except Exception:  # noqa: BLE001 - no distributed state (a unit test, a model built outside an engine)
+        return None
+
+
+def decide(fn: Callable[[], Any]) -> Any:
+    """`fn()` evaluated on rank 0 and broadcast to every rank of the world group, so every rank takes the same branch
+    (one CPU broadcast; nothing when there is one rank). Every rank must call it at the same point."""
+    world = _world()
+    if world is None or world[1] <= 1:
+        return fn()
+    from sglang.multimodal_gen.runtime.utils.distributed import broadcast_pyobj
+
+    rank, _size, group = world
+    mine = [None]
+    if rank == 0:
+        try:
+            mine = [{"value": fn(), "error": None}]
+        except Exception as exc:
+            # A malformed deadline or other root-only decision error must
+            # still reach the broadcast; peers must not wait in it forever.
+            mine = [{"value": None, "error": f"{type(exc).__name__}: {exc}"}]
+    decision = broadcast_pyobj(mine, rank, group, src=0)[0]
+    if decision["error"] is not None:
+        raise SynchronizedBatchError(f"rank 0 decision failed: {decision['error']}", retry_safe=True)
+    return decision["value"]
+
+
+def check(batch: Any, step_index: int, num_steps: int) -> None:
+    """Raise RequestAborted, on every rank at the same step, once rank 0 decides the request is aborted."""
+    reason = decide(lambda: local_reason(batch))
+    if reason:
+        ids = request_ids(batch)
+        raise RequestAborted(
+            f"{PREFIX}request {ids[0] if len(ids) == 1 else ids} aborted at step {step_index}/{num_steps}: {reason}"
+        )
