+++ b/python/sglang/multimodal_gen/runtime/models/dits/stablediffusion3.py
@@ -0,0 +1,590 @@
+# SPDX-License-Identifier: Apache-2.0
+"""StableDiffusion3 (MMDiT) transformer on SGLang's own layers.
+
+Joint attention runs through the engine's attention layer (``USPAttention``): the kernel that computes it is the
+one the engine's backend selector picks among the backends the DiT config declares
+(``StableDiffusion3TransformerArchConfig._supported_attention_backends``), and the sequence-parallel paths of that
+layer are reachable. Every linear layer inside a block is one of the engine's linear layers, built with the
+checkpoint parameter's own name as its ``prefix`` and with ``quant_config`` where the layer may be quantized, so
+tensor-parallel sharding, quantized weights and LoRA wrappers attach to the same modules the checkpoint names.
+
+Layout (diffusers checkpoint names, unchanged, so no parameter-name mapping is needed):
+
+    transformer_blocks.{i}.norm1.linear                   1536 -> 9216   ReplicatedLinear   (adaLN-Zero, 6 chunks)
+    transformer_blocks.{i}.norm1_context.linear           1536 -> 9216   ReplicatedLinear   (last block: 1536 -> 3072,
+                                                                                             AdaLayerNormContinuous)
+    transformer_blocks.{i}.attn.to_{q,k,v}                1536 -> 1536   ColumnParallelLinear (local heads)
+    transformer_blocks.{i}.attn.add_{q,k,v}_proj          1536 -> 1536   ColumnParallelLinear (local heads)
+    transformer_blocks.{i}.attn.to_out.0                  1536 -> 1536   RowParallelLinear
+    transformer_blocks.{i}.attn.to_add_out                1536 -> 1536   RowParallelLinear  (absent in the last block)
+    transformer_blocks.{i}.ff.net.0.proj / ff.net.2       1536 -> 6144 -> 1536   Column / Row, GELU(tanh) between
+    transformer_blocks.{i}.ff_context.net.0.proj / .2     the same (absent in the last block)
+
+Joint attention: image tokens first, then the context tokens (CLIP-L/G 77 + T5 256 = 333), concatenated on the
+sequence axis, no mask, softmax scale 1/sqrt(head_dim); the context is passed as the attention layer's replicated
+SUFFIX, so under Ulysses sequence parallelism it is kept whole on every rank. The last block keeps only the image
+stream. Outside the blocks the patch embedding, timestep/pooled embedding, context embedder, final norm and output
+projection are replicated and never quantized.
+
+Parallelism.
+  Tensor parallel: the column/row linears above hold 1/tp of every block projection per rank and attend over their
+  local heads; the row-parallel outputs are all-reduced over the TP group (to_out, to_add_out, ff.net.2 and
+  ff_context.net.2: four all-reduces per block, two in the last).
+  Sequence parallel (Ulysses): the pipeline hands every rank the WHOLE latent. The patch embedding runs on the whole
+  grid, so each token gets its dense position (the pos-embed table's crop centred on the image, not on a shard);
+  only then are the tokens split -- rank r keeps [r*q, (r+1)*q) with q = N // sp -- and the N % sp left-over tokens
+  ride on every rank in the attention layer's replicated suffix next to the context, so no token is padded or
+  masked and the joint attention equals the dense one at every image size. After the last block each rank's tokens
+  are all-gathered back in rank order and the whole latent leaves the DiT on every rank. Ring attention is not
+  supported (its path has no replicated suffix).
+"""
+
+from typing import Any
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from diffusers.models.embeddings import CombinedTimestepTextProjEmbeddings, PatchEmbed
+
+from sglang.multimodal_gen.configs.models.dits.stablediffusion3 import (
+    StableDiffusion3TransformerConfig,
+)
+from sglang.multimodal_gen.runtime.distributed import (
+    get_sp_parallel_rank,
+    get_sp_world_size,
+    get_tp_world_size,
+    sequence_model_parallel_all_gather,
+    tensor_model_parallel_all_reduce,
+)
+from sglang.multimodal_gen.runtime.distributed.parallel_state import (
+    get_ring_parallel_world_size,
+)
+from sglang.multimodal_gen.runtime.layers.attention import USPAttention
+from sglang.multimodal_gen.runtime.layers.linear import (
+    ColumnParallelLinear,
+    ReplicatedLinear,
+    RowParallelLinear,
+    UnquantizedLinearMethod,
+)
+from sglang.multimodal_gen.runtime.layers.quantization.configs.base_config import (
+    QuantizationConfig,
+)
+from sglang.multimodal_gen.runtime.models.dits.base import CachableDiT
+from sglang.multimodal_gen.runtime.utils.layerwise_offload import OffloadableDiTMixin
+from sglang.multimodal_gen.runtime.utils.logging_utils import init_logger
+
+logger = init_logger(__name__)
+
+# The block linears a quantization config may claim (relative to `transformer_blocks.{i}.`). Everything else --
+# the adaLN modulation linears, the embedders, `norm_out` and `proj_out` -- stays in the model dtype.
+QUANTIZABLE_BLOCK_LINEARS = (
+    "attn.to_q",
+    "attn.to_k",
+    "attn.to_v",
+    "attn.add_q_proj",
+    "attn.add_k_proj",
+    "attn.add_v_proj",
+    "attn.to_out.0",
+    "attn.to_add_out",
+    "ff.net.0.proj",
+    "ff.net.2",
+    "ff_context.net.0.proj",
+    "ff_context.net.2",
+)
+
+
+def _qc(quant_config: QuantizationConfig | None, rel: str) -> QuantizationConfig | None:
+    return quant_config if rel in QUANTIZABLE_BLOCK_LINEARS else None
+
+
+def sequence_shard(n_tokens: int, sp_size: int, sp_rank: int) -> tuple[int, int, int] | None:
+    """The image tokens one sequence-parallel rank computes: ``(start, end, n_rep)``, or None when the tokens are
+    not split (sp_size 1, or fewer tokens than ranks).
+
+    Rank ``sp_rank`` owns ``[start, end)`` with ``end - start == n_tokens // sp_size`` on every rank (Ulysses'
+    all-to-all needs the same count everywhere); the ``n_rep = n_tokens % sp_size`` trailing tokens
+    ``[n_tokens - n_rep, n_tokens)`` are held by every rank. Owned shards, in rank order, followed by the trailing
+    tokens are the whole sequence in its original order."""
+    if sp_size <= 1:
+        return None
+    q, n_rep = divmod(n_tokens, sp_size)
+    if q == 0:
+        return None
+    return sp_rank * q, (sp_rank + 1) * q, n_rep
+
+
+class SD3RowParallelLinear(RowParallelLinear):
+    """Keep BF16 shard products in FP32 until the TP reduction is complete.
+
+    The matrix operands and stored weights remain BF16. Rounding each shard
+    before summation introduces an extra error at every row projection. Add
+    the replicated bias once after reduction, then round the complete result.
+    Other precisions, quantized methods and TP1 retain the inherited path.
+    """
+
+    def _forward_fp32_reduced(self, input_):
+        x = input_
+        if not self.input_is_parallel:
+            x = x.chunk(self.tp_size, dim=-1)[self.tp_rank].contiguous()
+        partial = torch.mm(
+            x.reshape(-1, x.shape[-1]), self.weight.t(), out_dtype=torch.float32
+        )
+        output = tensor_model_parallel_all_reduce(partial, tp_group=self.tp_group)
+        if self.bias is not None and not self.skip_bias_add:
+            output = output + self.bias.float()
+        output = output.to(x.dtype).reshape(*x.shape[:-1], self.output_size)
+        return output, self.bias if self.skip_bias_add else None
+
+    def forward(self, input_):
+        if (
+            self.tp_size > 1
+            and self.reduce_results
+            and type(self.quant_method) is UnquantizedLinearMethod
+            and input_.device.type == "cuda"
+            and input_.dtype == torch.bfloat16
+            and self.weight.dtype == torch.bfloat16
+        ):
+            return self._forward_fp32_reduced(input_)
+        return super().forward(input_)
+
+
+class SD3AdaLayerNormZero(nn.Module):
+    """adaLN-Zero: LayerNorm without affine, modulated by six chunks of a linear map of SiLU(temb)."""
+
+    def __init__(self, dim: int, prefix: str = ""):
+        super().__init__()
+        self.linear = ReplicatedLinear(dim, 6 * dim, bias=True, prefix=f"{prefix}.linear")
+        self.norm = nn.LayerNorm(dim, elementwise_affine=False, eps=1e-6)
+
+    def forward(self, x: torch.Tensor, emb: torch.Tensor):
+        emb, _ = self.linear(F.silu(emb))
+        shift_msa, scale_msa, gate_msa, shift_mlp, scale_mlp, gate_mlp = emb.chunk(6, dim=1)
+        x = self.norm(x) * (1 + scale_msa[:, None]) + shift_msa[:, None]
+        return x, gate_msa, shift_mlp, scale_mlp, gate_mlp
+
+
+class SD3AdaLayerNormContinuous(nn.Module):
+    """LayerNorm without affine, modulated by (scale, shift) -- in that order -- from SiLU(conditioning)."""
+
+    def __init__(self, dim: int, conditioning_dim: int, prefix: str = ""):
+        super().__init__()
+        self.linear = ReplicatedLinear(conditioning_dim, 2 * dim, bias=True, prefix=f"{prefix}.linear")
+        self.norm = nn.LayerNorm(dim, elementwise_affine=False, eps=1e-6)
+
+    def forward(self, x: torch.Tensor, conditioning: torch.Tensor) -> torch.Tensor:
+        emb, _ = self.linear(F.silu(conditioning).to(x.dtype))
+        scale, shift = emb.chunk(2, dim=1)
+        return self.norm(x) * (1 + scale)[:, None, :] + shift[:, None, :]
+
+
+class SD3GELUProjection(nn.Module):
+    """`net.0` of the feed-forward: the up projection (column-parallel) followed by tanh-approximated GELU."""
+
+    def __init__(self, dim: int, inner_dim: int, quant_config=None, prefix: str = ""):
+        super().__init__()
+        self.proj = ColumnParallelLinear(
+            dim,
+            inner_dim,
+            bias=True,
+            gather_output=False,
+            quant_config=quant_config,
+            prefix=f"{prefix}.proj",
+        )
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x, _ = self.proj(x)
+        return F.gelu(x, approximate="tanh")
+
+
+class SD3FeedForward(nn.Module):
+    """dim -> 4*dim -> dim, GELU(tanh); `net.1` is the (inert) dropout slot the checkpoint layout keeps."""
+
+    def __init__(
+        self, dim: int, quant_config=None, prefix: str = "", rel: str = "ff"
+    ):
+        super().__init__()
+        inner = 4 * dim
+        self.net = nn.ModuleList(
+            [
+                SD3GELUProjection(
+                    dim,
+                    inner,
+                    quant_config=_qc(quant_config, f"{rel}.net.0.proj"),
+                    prefix=f"{prefix}.net.0",
+                ),
+                nn.Dropout(0.0),
+                SD3RowParallelLinear(
+                    inner,
+                    dim,
+                    bias=True,
+                    input_is_parallel=True,
+                    quant_config=_qc(quant_config, f"{rel}.net.2"),
+                    prefix=f"{prefix}.net.2",
+                ),
+            ]
+        )
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = self.net[0](x)
+        x, _ = self.net[2](x)
+        return x
+
+
+class SD3JointAttention(nn.Module):
+    """SD3's joint attention: image and context streams project separately, attend jointly, and split back."""
+
+    def __init__(
+        self,
+        dim: int,
+        num_heads: int,
+        head_dim: int,
+        context_pre_only: bool,
+        supported_attention_backends=None,
+        quant_config: QuantizationConfig | None = None,
+        prefix: str = "",
+    ):
+        super().__init__()
+        tp_size = get_tp_world_size()
+        assert (
+            num_heads % tp_size == 0
+        ), f"num_heads {num_heads} must be divisible by the tensor-parallel size {tp_size}"
+        self.num_heads = num_heads
+        self.local_heads = num_heads // tp_size
+        self.head_dim = head_dim
+        self.context_pre_only = context_pre_only
+        inner = num_heads * head_dim
+
+        def column(rel: str) -> ColumnParallelLinear:
+            return ColumnParallelLinear(
+                dim,
+                inner,
+                bias=True,
+                gather_output=False,
+                quant_config=_qc(quant_config, f"attn.{rel}"),
+                prefix=f"{prefix}.{rel}",
+            )
+
+        self.to_q, self.to_k, self.to_v = column("to_q"), column("to_k"), column("to_v")
+        self.add_q_proj = column("add_q_proj")
+        self.add_k_proj = column("add_k_proj")
+        self.add_v_proj = column("add_v_proj")
+        self.to_out = nn.ModuleList(
+            [
+                SD3RowParallelLinear(
+                    inner,
+                    dim,
+                    bias=True,
+                    input_is_parallel=True,
+                    quant_config=_qc(quant_config, "attn.to_out.0"),
+                    prefix=f"{prefix}.to_out.0",
+                )
+            ]
+        )
+        self.to_add_out = (
+            None
+            if context_pre_only
+            else SD3RowParallelLinear(
+                inner,
+                dim,
+                bias=True,
+                input_is_parallel=True,
+                quant_config=_qc(quant_config, "attn.to_add_out"),
+                prefix=f"{prefix}.to_add_out",
+            )
+        )
+        self.attn = USPAttention(
+            num_heads=self.local_heads,
+            head_size=head_dim,
+            causal=False,
+            supported_attention_backends=supported_attention_backends,
+            prefix=f"{prefix}.attn",
+        )
+
+    def _heads(self, x: torch.Tensor) -> torch.Tensor:
+        return x.unflatten(-1, (self.local_heads, self.head_dim))
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        encoder_hidden_states: torch.Tensor,
+        n_rep: int = 0,
+        skip_sp: bool = False,
+    ) -> tuple[torch.Tensor, torch.Tensor | None]:
+        """``hidden_states``: this rank's image tokens, its owned shard followed by the ``n_rep`` tokens every
+        sequence-parallel rank holds; ``skip_sp``: the tokens are not split across the SP group (every rank holds
+        all of them), so the attention runs locally."""
+        s_img = hidden_states.shape[1]
+        s_ctx = encoder_hidden_states.shape[1]
+        q, _ = self.to_q(hidden_states)
+        k, _ = self.to_k(hidden_states)
+        v, _ = self.to_v(hidden_states)
+        cq, _ = self.add_q_proj(encoder_hidden_states)
+        ck, _ = self.add_k_proj(encoder_hidden_states)
+        cv, _ = self.add_v_proj(encoder_hidden_states)
+        # [B, S_img + S_ctx, H_local, D]: image first, the context as the replicated suffix -- together with the
+        # image tokens every SP rank holds, so the all-to-all carries each token exactly once
+        q = self._heads(torch.cat([q, cq], dim=1))
+        k = self._heads(torch.cat([k, ck], dim=1))
+        v = self._heads(torch.cat([v, cv], dim=1))
+        out = self.attn(
+            q, k, v, num_replicated_suffix=n_rep + s_ctx, skip_sequence_parallel_override=skip_sp
+        )
+        out = out.flatten(2, 3).to(hidden_states.dtype)
+        img, ctx = out.split([s_img, s_ctx], dim=1)
+        img, _ = self.to_out[0](img)
+        if self.to_add_out is None:
+            return img, None
+        ctx, _ = self.to_add_out(ctx)
+        return img, ctx
+
+
+class SD3JointTransformerBlock(nn.Module):
+    """One MMDiT block: adaLN-Zero on both streams, joint attention, a feed-forward per stream."""
+
+    def __init__(
+        self,
+        dim: int,
+        num_heads: int,
+        head_dim: int,
+        context_pre_only: bool,
+        supported_attention_backends=None,
+        quant_config: QuantizationConfig | None = None,
+        prefix: str = "",
+    ):
+        super().__init__()
+        self.context_pre_only = context_pre_only
+        self.norm1 = SD3AdaLayerNormZero(dim, prefix=f"{prefix}.norm1")
+        self.norm1_context = (
+            SD3AdaLayerNormContinuous(dim, dim, prefix=f"{prefix}.norm1_context")
+            if context_pre_only
+            else SD3AdaLayerNormZero(dim, prefix=f"{prefix}.norm1_context")
+        )
+        self.attn = SD3JointAttention(
+            dim,
+            num_heads,
+            head_dim,
+            context_pre_only,
+            supported_attention_backends=supported_attention_backends,
+            quant_config=quant_config,
+            prefix=f"{prefix}.attn",
+        )
+        self.norm2 = nn.LayerNorm(dim, elementwise_affine=False, eps=1e-6)
+        self.ff = SD3FeedForward(dim, quant_config=quant_config, prefix=f"{prefix}.ff", rel="ff")
+        if context_pre_only:
+            self.norm2_context = None
+            self.ff_context = None
+        else:
+            self.norm2_context = nn.LayerNorm(dim, elementwise_affine=False, eps=1e-6)
+            self.ff_context = SD3FeedForward(
+                dim, quant_config=quant_config, prefix=f"{prefix}.ff_context", rel="ff_context"
+            )
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        encoder_hidden_states: torch.Tensor,
+        temb: torch.Tensor,
+        n_rep: int = 0,
+        skip_sp: bool = False,
+    ) -> tuple[torch.Tensor | None, torch.Tensor]:
+        norm_hidden, gate_msa, shift_mlp, scale_mlp, gate_mlp = self.norm1(hidden_states, emb=temb)
+        if self.context_pre_only:
+            norm_context = self.norm1_context(encoder_hidden_states, temb)
+        else:
+            norm_context, c_gate_msa, c_shift_mlp, c_scale_mlp, c_gate_mlp = self.norm1_context(
+                encoder_hidden_states, emb=temb
+            )
+
+        attn_out, context_attn_out = self.attn(norm_hidden, norm_context, n_rep=n_rep, skip_sp=skip_sp)
+
+        hidden_states = hidden_states + gate_msa.unsqueeze(1) * attn_out
+        norm_hidden = self.norm2(hidden_states) * (1 + scale_mlp[:, None]) + shift_mlp[:, None]
+        hidden_states = hidden_states + gate_mlp.unsqueeze(1) * self.ff(norm_hidden)
+
+        if self.context_pre_only:
+            return None, hidden_states
+
+        encoder_hidden_states = encoder_hidden_states + c_gate_msa.unsqueeze(1) * context_attn_out
+        norm_context = self.norm2_context(encoder_hidden_states) * (1 + c_scale_mlp[:, None]) + c_shift_mlp[:, None]
+        encoder_hidden_states = encoder_hidden_states + c_gate_mlp.unsqueeze(1) * self.ff_context(norm_context)
+        return encoder_hidden_states, hidden_states
+
+
+class SD3Transformer2DModel(CachableDiT, OffloadableDiTMixin):
+    _no_split_modules = ["SD3JointTransformerBlock"]
+    _skip_layerwise_casting_patterns = ["pos_embed", "norm"]
+    # LayerwiseOffloadManager offloads the joint blocks; embedders, norm_out and proj_out remain resident.
+    layer_names = ["transformer_blocks"]
+
+    def __init__(
+        self,
+        config: StableDiffusion3TransformerConfig,
+        hf_config: dict[str, Any] | None = None,
+        quant_config: QuantizationConfig | None = None,
+    ):
+        super().__init__(config=config, hf_config=hf_config)
+        self.config = config
+        arch = config.arch_config
+        if arch.qk_norm or arch.dual_attention_layers:
+            raise NotImplementedError(
+                "This SD3 transformer implements SD3-medium's MMDiT; qk_norm and dual-attention layers "
+                "(SD3.5) are not implemented here."
+            )
+        # Refused when the model is built, so the engine fails to start with the reason instead of every request of
+        # a ring profile failing inside its DiT forward (an error the caller only sees per request).
+        if _ring_world_size() > 1:
+            raise NotImplementedError(_RING_REFUSAL)
+        heads, head_dim = arch.num_attention_heads, arch.attention_head_dim
+        self.out_channels = arch.out_channels if arch.out_channels is not None else arch.in_channels
+        self.inner_dim = heads * head_dim
+        self.patch_size = arch.patch_size
+        self.hidden_size = self.inner_dim
+        self.num_attention_heads = heads
+        self.num_channels_latents = arch.in_channels
+        backends = getattr(arch, "_supported_attention_backends", None)
+
+        self.pos_embed = PatchEmbed(
+            height=arch.sample_size,
+            width=arch.sample_size,
+            patch_size=arch.patch_size,
+            in_channels=arch.in_channels,
+            embed_dim=self.inner_dim,
+            pos_embed_max_size=arch.pos_embed_max_size,
+        )
+        self.time_text_embed = CombinedTimestepTextProjEmbeddings(
+            embedding_dim=self.inner_dim, pooled_projection_dim=arch.pooled_projection_dim
+        )
+        self.context_embedder = ReplicatedLinear(
+            arch.joint_attention_dim, arch.caption_projection_dim, bias=True, prefix="context_embedder"
+        )
+        self.transformer_blocks = nn.ModuleList(
+            [
+                SD3JointTransformerBlock(
+                    self.inner_dim,
+                    heads,
+                    head_dim,
+                    context_pre_only=i == arch.num_layers - 1,
+                    supported_attention_backends=backends,
+                    quant_config=quant_config,
+                    prefix=f"transformer_blocks.{i}",
+                )
+                for i in range(arch.num_layers)
+            ]
+        )
+        self.norm_out = SD3AdaLayerNormContinuous(self.inner_dim, self.inner_dim, prefix="norm_out")
+        self.proj_out = ReplicatedLinear(
+            self.inner_dim,
+            arch.patch_size * arch.patch_size * self.out_channels,
+            bias=True,
+            prefix="proj_out",
+        )
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        encoder_hidden_states: torch.Tensor | None = None,
+        pooled_projections: torch.Tensor | None = None,
+        timestep: torch.LongTensor | None = None,
+        block_controlnet_hidden_states: list | None = None,
+        guidance: torch.Tensor | None = None,
+        joint_attention_kwargs: dict[str, Any] | None = None,
+        skip_layers: list[int] | None = None,
+    ) -> torch.Tensor:
+        if encoder_hidden_states is None:
+            raise ValueError("encoder_hidden_states must be provided.")
+        if pooled_projections is None:
+            raise ValueError("pooled_projections must be provided.")
+        if not torch.is_autocast_enabled(hidden_states.device.type):
+            # without autocast nothing reconciles dtypes inside the DiT: its conditioning (the merged text
+            # embeds, the pooled CLIP projections -- each in its text encoders' precision) is cast to the
+            # latents' dtype, the compute dtype the denoising stage set from dit_precision, as DecodingStage casts
+            # the VAE's latents when its autocast is off. Under autocast this is skipped: nothing changes there.
+            encoder_hidden_states = encoder_hidden_states.to(hidden_states.dtype)
+            pooled_projections = pooled_projections.to(hidden_states.dtype)
+
+        height, width = hidden_states.shape[-2:]
+        # the whole grid, every token at its dense position; split across the SP group only after this
+        hidden_states = self.pos_embed(hidden_states)
+        temb = self.time_text_embed(timestep, pooled_projections)
+        encoder_hidden_states, _ = self.context_embedder(encoder_hidden_states)
+
+        n_tokens = hidden_states.shape[1]
+        shard, skip_sp = self._sequence_shard(n_tokens)
+        n_rep = shard[2] if shard is not None else 0
+
+        def take(t: torch.Tensor) -> torch.Tensor:
+            """This rank's tokens of a whole-sequence tensor: its owned shard, then the trailing shared ones."""
+            if shard is None:
+                return t
+            start, end, rep = shard
+            return torch.cat([t[:, start:end], t[:, n_tokens - rep :]], dim=1) if rep else t[:, start:end]
+
+        hidden_states = take(hidden_states)
+
+        skip = set(skip_layers) if skip_layers else set()
+        if skip and any(getattr(m, "enabled", False) for m in (getattr(self, "layerwise_offload_managers", None) or [])):
+            # the manager streams block i+1 in from block i's pre-hook and releases a block in its post-hook: a
+            # skipped block runs neither, so the block after it would run on released placeholder weights
+            raise NotImplementedError(
+                "skip_layers is not supported together with --dit-layerwise-offload: a skipped block would leave "
+                "the next block's weights offloaded"
+            )
+        interval_control = (
+            len(self.transformer_blocks) / len(block_controlnet_hidden_states)
+            if block_controlnet_hidden_states is not None
+            else 0
+        )
+        for index_block, block in enumerate(self.transformer_blocks):
+            if index_block not in skip:
+                encoder_hidden_states, hidden_states = block(
+                    hidden_states, encoder_hidden_states, temb, n_rep=n_rep, skip_sp=skip_sp
+                )
+            if block_controlnet_hidden_states is not None and not block.context_pre_only:
+                hidden_states = hidden_states + take(
+                    block_controlnet_hidden_states[int(index_block / interval_control)]
+                )
+
+        hidden_states = self.norm_out(hidden_states, temb)
+        hidden_states, _ = self.proj_out(hidden_states)
+
+        if shard is not None:
+            # every rank's owned tokens, in rank order, then the shared trailing ones: the whole sequence again
+            owned = shard[1] - shard[0]
+            gathered = sequence_model_parallel_all_gather(hidden_states[:, :owned].contiguous(), dim=1)
+            hidden_states = torch.cat([gathered, hidden_states[:, owned:]], dim=1) if n_rep else gathered
+
+        # unpatchify: [B, h*w, p*p*C] -> [B, C, h*p, w*p]
+        p = self.patch_size
+        h, w = height // p, width // p
+        hidden_states = hidden_states.reshape(hidden_states.shape[0], h, w, p, p, self.out_channels)
