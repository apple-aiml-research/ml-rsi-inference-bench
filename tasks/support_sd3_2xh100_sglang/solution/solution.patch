+def _metadata_lora_alpha(meta: dict, module_name: str) -> float | None:
+    """lora_alpha for one module as peft resolves it: the first alpha_pattern key that matches the end of the
+    module name at a dot boundary, else the adapter-wide lora_alpha; None when the metadata names neither."""
+    for prefix in ("transformer.", ""):
+        for key, value in (meta.get(prefix + "alpha_pattern") or {}).items():
+            if re.match(rf"(.*\.)?({key})$", module_name):
+                return float(value)
+        if meta.get(prefix + "lora_alpha") is not None:
