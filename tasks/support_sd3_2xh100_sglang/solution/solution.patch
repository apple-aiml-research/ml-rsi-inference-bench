+++ b/python/sglang/multimodal_gen/runtime/managers/sd3_dynamic_batching.py
@@ -0,0 +1,310 @@
+# SPDX-License-Identifier: Apache-2.0
+"""SD3 cross-request batching. The scheduler remains the sole queue owner.
+
+Only fresh, compatible T2I requests share a pipeline forward. Every generated
+row retains its original request's conditioning and seed. Controls are queue
+fences: an adapter change cannot overtake a generation. A failed fused forward
+is retried at most once per member; cancellation retries only surviving
+members from their original inputs (not partially advanced scheduler/RNG state).
+"""
+from __future__ import annotations
+
+import copy
+import dataclasses
+import enum
+import math
+from typing import Any
+
+from sglang.multimodal_gen.runtime.managers import request_abort
+from sglang.multimodal_gen.runtime.pipelines_core.schedule_batch import OutputBatch, Req
+
+
+_PER_REQUEST = {
+    "request_id", "timeout_s", "prompt", "negative_prompt", "seed",
+    "num_outputs_per_prompt", "output_path", "output_file_name",
+    "save_output", "return_file_paths_only", "perf_dump_path", "suppress_logs",
+}
+_RUNTIME = {
+    "sampling_params", "extra", "metrics", "prompt_embeds", "negative_prompt_embeds",
+    "pooled_embeds", "neg_pooled_embeds", "generator", "seeds", "output",
+    "prompt_attention_mask", "negative_attention_mask",
+}
+_RESERVED = {"merged_request_ids", "sd3_batch_members", "sd3_batch_seeds"}
+
+
+def enabled(server_args: Any) -> bool:
+    config = getattr(server_args, "pipeline_config", None)
+    return (
+        any(c.__name__ == "StableDiffusion3PipelineConfig" for c in type(config).__mro__)
+        and getattr(server_args, "batching_max_size", 1) > 1
+    )
+
+
+def distributed_enabled(server_args: Any) -> bool:
+    """Synchronize SD3 TP/SP failures even when request batching is disabled.
+
+    The ordinary singleton path uses the same distributed DiT. A post-forward
+    exception on one rank must reach its peers before their next collective.
+    CFG parallel has rank-specific positive/negative boundaries and is not
+    admitted here; it needs a separately aligned synchronization protocol.
+    This switch changes error coordination only, never batching admission.
+    """
+    config = getattr(server_args, "pipeline_config", None)
+    return (
+        any(c.__name__ == "StableDiffusion3PipelineConfig" for c in type(config).__mro__)
+        and getattr(server_args, "num_gpus", 1) > 1
+        and not getattr(server_args, "enable_cfg_parallel", False)
+    )
+
+
+def execute_single(worker: Any, req: Req) -> OutputBatch:
+    """The same request runs on every rank; error metadata is agreed by all.
+
+    Non-root tensors need not be present (decode can be rank-0-only). They are
+    never broadcast or used to manufacture a root result. Only errors and the
+    safety of reusing the existing process group cross this control boundary.
+    """
+    if distributed_enabled(worker.server_args):
+        request_abort.check_batch_group()
+    out = worker._execute_single([req])
+    if not distributed_enabled(worker.server_args):
+        return out
+    status = None if not out.error else {
+        "error": str(out.error),
+        "retry_safe": bool(getattr(out, "_sd3_retry_safe", False)),
+    }
+    failures = [(rank, item) for rank, item in enumerate(request_abort.gather_status(status)) if item]
+    if failures:
+        out = OutputBatch(error="; ".join(f"rank {rank}: {item['error']}" for rank, item in failures))
+        out._sd3_retry_safe = all(item["retry_safe"] for _, item in failures)
+    return out
+
+
+def _freeze(value: Any) -> Any:
+    """Fail closed on opaque inputs; never equate tensors by their repr/name."""
+    if value is None or isinstance(value, (str, bool, int)):
+        return (type(value).__name__, value)
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError("non-finite batching parameter")
+        return ("float", value)
+    if isinstance(value, enum.Enum):
+        return (type(value).__module__, type(value).__qualname__, value.name)
+    if isinstance(value, (tuple, list)):
+        return (type(value).__name__, tuple(_freeze(v) for v in value))
+    if isinstance(value, (set, frozenset)):
+        # SamplingParams.from_user_sampling_params_args attaches an `_explicit_fields` set.
+        return (type(value).__name__, tuple(sorted(_freeze(v) for v in value)))
+    if isinstance(value, dict):
+        return tuple(sorted((str(k), _freeze(v)) for k, v in value.items()))
+    if dataclasses.is_dataclass(value):
+        return (type(value).__qualname__, _freeze(vars(value)))
+    raise ValueError(f"opaque batching parameter: {type(value).__name__}")
+
+
+def compatibility_key(req: Any) -> Any | None:
+    if not isinstance(req, Req) or req.is_warmup or not isinstance(req.prompt, str):
+        return None
+    if not isinstance(req.negative_prompt, (str, type(None))):
+        return None
+    if type(req.seed) is not int or type(req.num_outputs_per_prompt) is not int or req.num_outputs_per_prompt < 1:
+        return None
+    # Precomputed/processed requests retain their existing singleton entry path.
+    if req.image_path is not None or req.latents is not None or req.generator is not None:
+        return None
+    if any(value is not None and (not isinstance(value, list) or len(value) > 0)
+           for value in (req.prompt_embeds, req.negative_prompt_embeds, req.pooled_embeds, req.neg_pooled_embeds)):
+        return None
+    if req.rollout or (set(req.extra or {}) & _RESERVED):
+        return None
+    try:
+        sampling = {k: v for k, v in vars(req.sampling_params).items() if k not in _PER_REQUEST}
+        extra = {k: v for k, v in (req.extra or {}).items() if k != "deadline_epoch"}
+        # Include unknown fields too: future inference/adapter parameters must
+        # not silently be discarded from the compatibility decision.
+        state = {k: v for k, v in vars(req).items() if k not in _RUNTIME and k not in _PER_REQUEST}
+        return (type(req.sampling_params).__qualname__, _freeze(sampling), _freeze(extra), _freeze(state),
+                bool(req.do_classifier_free_guidance))
+    except (ValueError, TypeError):
+        return None
+
+
+def merge_requests(reqs: list[Req]) -> Req:
+    if not reqs:
+        raise ValueError("empty SD3 batch")
+    key = compatibility_key(reqs[0])
+    if key is None or any(compatibility_key(r) != key for r in reqs):
+        raise ValueError("incompatible SD3 requests")
+    merged = copy.deepcopy(reqs[0])
+    prompts, negatives, seeds, members = [], [], [], []
+    for req in reqs:
+        start = len(seeds)
+        n = req.num_outputs_per_prompt
+        prompts.extend([req.prompt] * n)
+        negatives.extend([req.negative_prompt] * n)
+        seeds.extend(req.seed + i for i in range(n))
+        members.append({"request_id": req.request_id, "start": start, "stop": start + n,
+                        "deadline_epoch": (req.extra or {}).get("deadline_epoch")})
+    merged.prompt = prompts
+    merged.negative_prompt = negatives if merged.do_classifier_free_guidance else reqs[0].negative_prompt
+    merged.num_outputs_per_prompt = 1
+    merged.request_id = "sd3-batch:" + ":".join(str(r.request_id) for r in reqs)
+    merged.extra = copy.deepcopy(reqs[0].extra or {})
+    merged.extra.pop("deadline_epoch", None)
+    merged.extra.update(merged_request_ids=[r.request_id for r in reqs],
+                        sd3_batch_members=members, sd3_batch_seeds=seeds)
+    merged.metrics.request_id = merged.request_id
+    # Materialize each caller's filenames/performance report only after splitting.
+    merged.save_output = False
+    merged.return_file_paths_only = False
+    merged.perf_dump_path = None
+    return merged
+
+
+def split_output(out: OutputBatch, reqs: list[Req]) -> list[OutputBatch]:
+    count = sum(r.num_outputs_per_prompt for r in reqs)
+    if out.error:
+        raise ValueError(out.error)
+    if out.output is not None and len(out.output) != count:
+        raise ValueError(f"SD3 fused output has {len(out.output)} rows, expected {count}")
+    results, start = [], 0
+    for req in reqs:
+        stop = start + req.num_outputs_per_prompt
+        part = copy.copy(out)
+        if out.output is not None:
+            value = out.output[start:stop]
+            part.output = value.clone() if hasattr(value, "clone") else copy.deepcopy(value)
+        # SD3 trajectory_latents is [steps, batch, channels, height, width].
+        if out.trajectory_latents is not None:
+            if out.trajectory_latents.ndim < 2 or out.trajectory_latents.shape[1] != count:
+                raise ValueError("SD3 trajectory batch axis is invalid")
+            part.trajectory_latents = out.trajectory_latents[:, start:stop].clone()
+        if out.noise_pred is not None:
+            if out.noise_pred.shape[0] != count:
+                raise ValueError("SD3 noise prediction batch axis is invalid")
+            part.noise_pred = out.noise_pred[start:stop].clone()
+        if out.trajectory_decoded is not None:
+            part.trajectory_decoded = [t[start:stop].clone() for t in out.trajectory_decoded]
+        part.metrics = copy.deepcopy(out.metrics)
+        if part.metrics is not None:
+            part.metrics.request_id = req.request_id
+        part.output_file_paths = None
+        results.append(part)
+        start = stop
+    return results
+
+
+def _member_reasons(reqs: list[Req]) -> dict[int, str]:
+    def read():
+        # Poll before collecting reasons, using the same installed scheduler
+        # poller as the denoising loop. Only rank 0 consumes the ROUTER socket.
+        request_abort.local_reason(reqs[0])
+        return {i: reason for i, req in enumerate(reqs)
+                if (reason := request_abort.aborted_reason(req.request_id) or request_abort.deadline_reason(req))}
+    return request_abort.decide(read)
+
+
+def _cancelled(req: Req, reason: str) -> OutputBatch:
+    return OutputBatch(error=f"{request_abort.PREFIX}request {req.request_id}: {reason}")
+
+
+def materialize(worker: Any, req: Req, out: OutputBatch) -> OutputBatch:
+    if out.error:
+        return out
+    # This uses the original engine's save implementation and original Req's
+    # filename builder, including multi-output suffixes and compression options.
+    if req.save_output and req.return_file_paths_only:
+        if worker.rank == 0 and out.output is not None:
+            from sglang.multimodal_gen.runtime.entrypoints.utils import save_outputs
+            out.output_file_paths = save_outputs(
+                out.output, req.data_type, req.fps, True,
+                lambda idx: req.output_file_path(len(out.output), idx),
+                audio=out.audio, audio_sample_rate=out.audio_sample_rate,
+                output_compression=req.output_compression,
+                enable_frame_interpolation=req.enable_frame_interpolation,
+                frame_interpolation_exp=req.frame_interpolation_exp,
+                frame_interpolation_scale=req.frame_interpolation_scale,
+                frame_interpolation_model_path=req.frame_interpolation_model_path,
+                enable_upscaling=req.enable_upscaling, upscaling_model_path=req.upscaling_model_path,
+                upscaling_scale=req.upscaling_scale,
+            )
+        out.output = out.audio = out.audio_sample_rate = None
+    if req.perf_dump_path is not None and out.metrics is not None and worker.rank == 0:
+        from sglang.multimodal_gen.runtime.utils.perf_logger import PerformanceLogger
+        PerformanceLogger.dump_benchmark_report(
+            file_path=req.perf_dump_path, metrics=out.metrics,
+            meta={"model": worker.server_args.model_path}, tag="server_perf_dump")
+    return out
+
+
+def execute_batch(worker: Any, reqs: list[Req]) -> list[OutputBatch]:
+    """Execute one real fused forward; recover boundedly without altering originals."""
+    reasons = _member_reasons(reqs)
+    survivors = [i for i in range(len(reqs)) if i not in reasons]
+    results = [None] * len(reqs)
+    for i, reason in reasons.items():
+        results[i] = _cancelled(reqs[i], reason)
+    if not survivors:
+        return results
+    live = [reqs[i] for i in survivors]
+    if len(live) == 1:
+        results[survivors[0]] = execute_single(worker, copy.deepcopy(live[0]))
+        return results
+    with request_abort.synchronize_errors(distributed_enabled(worker.server_args), "SD3 merge requests"):
+        merged = merge_requests(live)
+    out = execute_single(worker, merged)
+    reasons = _member_reasons(live)
+    # Some decode paths return tensors only on rank 0. Validate every present
+    # tensor but require a tensor only there. All ranks take the same retry.
+    def failure():
+        if out.error:
+            return str(out.error)
+        if worker.rank == 0 and out.output is None:
+            return "SD3 fused forward returned no output on rank 0"
+        try:
+            split_output(out, live)
+        except Exception as exc:
+            return str(exc)
+        return None
+    if distributed_enabled(worker.server_args):
+        failures = [(rank, text) for rank, text in enumerate(request_abort.gather_status(failure(), "SD3 output validation")) if text]
+        error = "; ".join(f"rank {rank}: {text}" for rank, text in failures) if failures else None
+    else:
+        error = request_abort.decide(failure)
+    if error:
+        retry_safe = (not distributed_enabled(worker.server_args)
+                      or bool(getattr(out, "_sd3_retry_safe", False))
+                      # A successful forward with malformed output is a
+                      # completed collective sequence, safe to isolate.
+                      or not out.error)
+        if not retry_safe:
+            for j, req in enumerate(live):
+                results[survivors[j]] = (_cancelled(req, reasons[j]) if j in reasons
+                                         else OutputBatch(error=error))
+            return results
+        # Release fused latents/conditioning before retrying, including after
+        # OOM. Keeping `merged` alive can force every otherwise valid singleton
+        # to fail again on the same retained allocation.
+        del merged, out
+        import gc
+        gc.collect()
+        import torch
+        if torch.cuda.is_initialized():
+            torch.cuda.empty_cache()
+        for j, req in enumerate(live):
+            i = survivors[j]
+            results[i] = (_cancelled(req, reasons[j]) if j in reasons else
+                          execute_single(worker, copy.deepcopy(req)))
+    else:
+        parts = split_output(out, live)
+        for j, part in enumerate(parts):
+            i = survivors[j]
+            if j in reasons:
+                results[i] = _cancelled(live[j], reasons[j])
+            else:
+                try:
+                    results[i] = materialize(worker, live[j], part)
+                except Exception as exc:
+                    # Filesystem/postprocessing failure belongs to this caller.
+                    results[i] = OutputBatch(error=f"Error saving request {live[j].request_id}: {exc}")
+    return results
