+
+    scaling_factor: float = 1.5305
+    shift_factor: float = 0.0609
+
+    spatial_compression_ratio: int = 8
+    temporal_compression_ratio: int = 1
+
+    in_channels: int = 3
+    out_channels: int = 3
+    latent_channels: int = 16
+    sample_size: int = 128
+
+    block_out_channels: tuple[int, ...] = (128, 256, 512, 512)
