+def _read_lora_adapter_metadata(path: str) -> dict:
+    """The adapter's LoraConfig from the file's safetensors header, or {} when it carries none."""
+    if not str(path).endswith(".safetensors"):
+        return {}
+    with safe_open(path, framework="pt", device="cpu") as f:
+        raw = (f.metadata() or {}).get(_LORA_ADAPTER_METADATA_KEY)
