diff --git a/python/sglang/multimodal_gen/runtime/distributed/group_timeout.py b/python/sglang/multimodal_gen/runtime/distributed/group_timeout.py
new file mode 100644
index 0000000..66187bb
--- /dev/null
+++ b/python/sglang/multimodal_gen/runtime/distributed/group_timeout.py
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: Apache-2.0
+"""One timeout for every process group the runtime builds.
+
+torch's ``new_group`` does not inherit the default group's timeout: without an explicit ``timeout`` it uses torch's
+per-backend default (10 min for NCCL, 30 min for gloo), whatever ``--dist-timeout`` says.
+``init_distributed_environment`` records the server's timeout here. Every ``new_group`` call in
+``runtime/distributed`` passes it on, bounding tensor-, sequence-, Ulysses- and ring-parallel collectives
+when a rank dies or diverges.
+"""
+
+from __future__ import annotations
+
+import datetime
+
+import torch
+import torch.distributed
+
+_GROUP_TIMEOUT: datetime.timedelta | None = None
+
+
+def set_group_timeout(seconds: float | None) -> None:
+    """Record the timeout (seconds) later groups are built with; ``None`` restores torch's per-backend defaults."""
+    global _GROUP_TIMEOUT
+    _GROUP_TIMEOUT = None if seconds is None else datetime.timedelta(seconds=float(seconds))
+
+
+def get_group_timeout() -> datetime.timedelta | None:
+    return _GROUP_TIMEOUT
+
+
+def new_group(*args, **kwargs):
+    """``torch.distributed.new_group`` with the recorded timeout unless the caller passes its own."""
+    if _GROUP_TIMEOUT is not None and kwargs.get("timeout") is None:
+        kwargs["timeout"] = _GROUP_TIMEOUT
+    return torch.distributed.new_group(*args, **kwargs)
