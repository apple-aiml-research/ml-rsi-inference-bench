+async def _forward_watching(scheduler_client: AsyncSchedulerClient, batch, disconnect):
+    """The request's forward; if the HTTP caller disconnects meanwhile (`disconnect.is_disconnected()`), or this
+    handler is cancelled, the request is aborted in the engine instead of running to the end for nobody."""
+    fwd = asyncio.ensure_future(scheduler_client.forward([batch]))
+    try:
+        while True:
+            done, _ = await asyncio.wait({fwd}, timeout=DISCONNECT_POLL_S)
+            if done:
+                return fwd.result()
+            if disconnect is not None and await disconnect.is_disconnected():
+                await _abort_quietly(scheduler_client, getattr(batch, "request_id", None))
