@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Async scheduling for diffusion requests.
+
+These rules live here so Scheduler.schedule() and AsyncScheduler stay
+unchanged. VllmConfig selects this class for a diffusion model under async
+scheduling. A sync scheduler creates no output placeholders, which the rule
+reads.
+"""
+
+from vllm.v1.core.sched.async_scheduler import AsyncScheduler
+from vllm.v1.core.sched.output import SchedulerOutput
+from vllm.v1.request import Request
+
+
+def _is_read(request: Request) -> bool:
+    params = request.sampling_params
+    extra = params.extra_args if params is not None else None
+    return bool(extra and extra.get("diffusion_read_only"))
+
+
+def _read_in_flight(request: Request, width: int) -> bool:
+    """True when a one-canvas read has all its denoise steps in flight.
+
+    The read emits its canvas on the last step and ends, so a further step
+    would be discarded.
+    """
+    params = request.sampling_params
+    extra = params.extra_args if params is not None else None
+    if not extra or not extra.get("diffusion_read_only"):
+        return False
+    steps = extra.get("diffusion_max_steps")
+    if not steps:
+        return False
+    # Each in-flight denoise step holds one canvas of placeholders.
+    return request.num_output_placeholders >= int(steps) * width
+
+
+class DiffusionAsyncScheduler(AsyncScheduler):
+    def schedule(self) -> SchedulerOutput:
+        for request in self.running:
+            if _read_in_flight(request, self.num_spec_tokens):
+                # Scheduler.schedule()'s max_tokens guard cannot be reached
+                # from a subclass. schedule() advances current_step before it
+                # checks decode eligibility, so current_step + 2 skips this
+                # call alone. max keeps a longer pipeline-parallel wait.
+                request.next_decode_eligible_step = max(
+                    request.next_decode_eligible_step, self.current_step + 2
+                )
+        return super().schedule()
+
+    def _update_request_with_output(
+        self, request: Request, new_token_ids: list[int]
+    ) -> tuple[list[int], bool]:
+        if new_token_ids and _is_read(request):
+            # A read emits its canvas without a commit forward: the KV at those
+            # positions is its denoise pass's, over the seed canvas, not the
+            # emitted tokens'. They are never counted as computed, so the blocks
+            # are never hashed under the emitted tokens (a later prompt holding
+            # the same tokens would otherwise hit that KV).
+            request.num_computed_tokens = min(
+                request.num_computed_tokens, request.num_prompt_tokens
+            )
+        return super()._update_request_with_output(request, new_token_ids)
