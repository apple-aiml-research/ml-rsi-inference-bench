@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Image spans under per-sequence phases for DiffusionGemma on FA4 (CuTe-DSL mask_mod).
+
+Imports nothing beyond torch at module load, so callers outside the model (the attend
+operator) can use it without the attention backend's import chain.
+"""
+
+import functools
+from typing import Any
+
+import torch
+
+DIFFUSION_GEMMA_WINDOW = 1024
+DIFFUSION_GEMMA_MAX_SPANS = 8
+
+
+@functools.cache
+def _make_diffusion_gemma_image_mask_mod(max_spans: int, window: int):
+    """CuTe-DSL mask_mod for image spans under per-sequence phases (DiffusionGemma).
+
+    aux_tensors[0]: int32 [batch] phase (1 encode, 0 denoise); aux_tensors[1]: int32
+    [batch, max_spans, 2] absolute half-open image spans. With q the row's absolute
+    position (q_idx + seqlen_k - seqlen_q) and c = seqlen_k - seqlen_q:
+      encode:  keep = (kv <= q and (no window or kv > q - window)) or (q, kv in one span)
+      denoise: keep = no window or kv >= c - (window - 1)
+    """
+    import cutlass
+    import cutlass.cute as cute
+    from cutlass import Int32  # type: ignore[attr-defined]
+
+    from vllm.vllm_flash_attn.cute.utils import (  # type: ignore[import-untyped]
+        scalar_to_ssa,
+    )
+
+    @cute.jit
+    def diffusion_gemma_image_mask_mod(
+        batch_idx: cute.TensorSSA,
+        head_idx: cute.TensorSSA,
+        q_idx: cute.TensorSSA,
+        kv_idx: cute.TensorSSA,
+        seqlen_info,
+        aux_tensors,
+    ):
+        phase = aux_tensors[0]
+        spans = aux_tensors[1]
+        b = batch_idx[0]
+        offset = scalar_to_ssa(seqlen_info.seqlen_k - seqlen_info.seqlen_q, Int32)
+        q_abs = q_idx + offset
+        keep_enc = kv_idx <= q_abs
+        if cutlass.const_expr(window > 0):
+            keep_enc = keep_enc & (kv_idx > q_abs - window)
+        for i in cutlass.range_constexpr(max_spans):  # type: ignore[attr-defined]
+            s_lo = scalar_to_ssa(spans[b, i, 0], Int32)
+            s_hi = scalar_to_ssa(spans[b, i, 1], Int32)
+            in_q = (q_abs >= s_lo) & (q_abs < s_hi)
+            in_k = (kv_idx >= s_lo) & (kv_idx < s_hi)
+            keep_enc = keep_enc | (in_q & in_k)
+        if cutlass.const_expr(window > 0):
+            keep_den = kv_idx >= offset - (window - 1)
+        else:
+            keep_den = kv_idx >= 0
+        is_enc = scalar_to_ssa(phase[b], Int32) != 0
+        is_den = scalar_to_ssa(phase[b], Int32) == 0
+        return (is_enc & keep_enc) | (is_den & keep_den)
+
+    diffusion_gemma_image_mask_mod.use_fast_sampling = True
+    return diffusion_gemma_image_mask_mod
+
+
+def diffusion_gemma_image_mask(
+    phase: torch.Tensor, image_ranges: torch.Tensor, has_window: bool
+) -> tuple[Any, list[torch.Tensor]]:
+    """The mask_mod and aux tensors for a batch carrying image spans under
+    per-sequence phases; spans padded to a fixed width so one kernel serves all."""
+    spans = image_ranges.to(torch.int32)
+    if spans.shape[1] < DIFFUSION_GEMMA_MAX_SPANS:
+        spans = torch.nn.functional.pad(
+            spans, (0, 0, 0, DIFFUSION_GEMMA_MAX_SPANS - spans.shape[1])
+        )
+    mask_mod = _make_diffusion_gemma_image_mask_mod(
+        spans.shape[1], DIFFUSION_GEMMA_WINDOW if has_window else 0
+    )
+    return mask_mod, [phase.to(torch.int32).contiguous(), spans.contiguous()]
