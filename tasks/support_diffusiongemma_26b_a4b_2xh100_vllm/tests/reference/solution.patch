new file mode 100644
index 0000000000000000000000000000000000000000..227ae1a599e3b2c7aa08d8fbaff05872a64c479d
--- /dev/null
+++ b/diffusion_gemma_attend.py
@@ -0,0 +1,63 @@
+"""Oracle adapter for the `attend` contract (benchmark-authored; section 6.1 of the task's contract).
+
+A thin wrapper over the served FA4 path of this tree: the FlashAttention backend's paged layout for
+the layer kind, and `flash_attn_varlen_func` called exactly as FlashAttentionImpl.forward calls it for
+DiffusionGemma -- the per-sequence phase tensor always passed (int32; the fork's compile key does not
+distinguish calls with and without it), a sliding layer's window made symmetric under per-sequence
+phases, `causal = not has_window`, scale 1.0, no softcap, the served split heuristic.
+"""
+from __future__ import annotations
+
+import torch
+
+W = 1024
+BLOCK_SIZE = 16
+SHAPES = {("sliding", 1): (16, 8, 256), ("sliding", 2): (8, 4, 256),
+          ("full", 1): (16, 2, 512), ("full", 2): (8, 1, 512)}
+
+
+class _Cache:
+    def __init__(self, layer_kind: str, tp_size: int, capacity_tokens: int, device) -> None:
+        _, num_kv_heads, head_dim = SHAPES[(layer_kind, tp_size)]
+        num_blocks = -(-int(capacity_tokens) // BLOCK_SIZE) + 1
+        # FlashAttentionBackend.get_kv_cache_shape: (2, num_blocks, block_size, num_kv_heads, head_size)
+        self.kv = torch.zeros(2, num_blocks, BLOCK_SIZE, num_kv_heads, head_dim, dtype=torch.bfloat16,
+                              device=device)
+        self.layer_kind = layer_kind
+
+
+def create_cache(layer_kind: str, tp_size: int, capacity_tokens: int, device) -> _Cache:
+    return _Cache(layer_kind, tp_size, capacity_tokens, device)
+
+
+def cache_views(cache: _Cache) -> tuple[torch.Tensor, torch.Tensor]:
+    return cache.kv[0], cache.kv[1]
+
+
+def attend(cache: _Cache, q: torch.Tensor, block_table: torch.Tensor, seq_lens: torch.Tensor,
+           query_start_loc: torch.Tensor, encode: torch.Tensor, image_ranges: torch.Tensor,
+           layer_kind: str) -> torch.Tensor:
+    from vllm.vllm_flash_attn import flash_attn_varlen_func
+
+    key_cache, value_cache = cache.kv[0], cache.kv[1]
+    has_window = layer_kind == "sliding"
+    window = [W - 1, W - 1] if has_window else [-1, -1]
+    q_lens = query_start_loc[1:] - query_start_loc[:-1]
+    out = torch.empty_like(q)
+    if q.shape[0] == 0:
+        return out
+    mask_mod, aux = None, None
+    if image_ranges is not None and image_ranges.numel() and bool((image_ranges[..., 1] > image_ranges[..., 0]).any()):
+        from vllm.v1.attention.ops.diffusion_gemma_mask import diffusion_gemma_image_mask
+
+        mask_mod, aux = diffusion_gemma_image_mask(encode, image_ranges, has_window)
+    flash_attn_varlen_func(
+        q=q, k=key_cache, v=value_cache, out=out,
+        cu_seqlens_q=query_start_loc.to(torch.int32), max_seqlen_q=int(q_lens.max()),
+        seqused_k=seq_lens.to(torch.int32), max_seqlen_k=int(seq_lens.max()),
+        softmax_scale=1.0, causal=not has_window, window_size=window,
+        block_table=block_table.to(torch.int32), softcap=0.0, fa_version=4,
+        dynamic_causal=encode.to(torch.int32), num_splits=0,
+        mask_mod=mask_mod, aux_tensors=aux,
+    )
+    return out
