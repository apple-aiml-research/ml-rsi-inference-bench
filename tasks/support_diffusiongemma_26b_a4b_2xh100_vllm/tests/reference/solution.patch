@@ -0,0 +1,128 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Request validation for discrete diffusion models: the one-canvas read mode."""
+
+from typing import TYPE_CHECKING, Any
+
+from vllm.exceptions import VLLMValidationError
+
+if TYPE_CHECKING:
+    from vllm.sampling_params import SamplingParams
+
+READ_FIELDS = (
+    "diffusion_read_only",
+    "diffusion_seed_canvas",
+    "diffusion_max_steps",
+    "diffusion_target_token_ids",
+)
+
+
+def _check(valid: bool, message: str) -> None:
+    if not valid:
+        raise VLLMValidationError(message, parameter="extra_args")
+
+
+def _token_ids(value: Any, name: str) -> list[int]:
+    """A list of token ids, or the comma-separated decimal string `vllm_xargs`
+    carries on completions, which admit only scalars there."""
+    if isinstance(value, str):
+        parts = [p.strip() for p in value.split(",")]
+        _check(
+            all(p.lstrip("-").isdigit() for p in parts),
+            f"{name} must be comma-separated token ids.",
+        )
+        return [int(p) for p in parts]
+    _check(
+        isinstance(value, (list, tuple))
+        and all(isinstance(t, int) and not isinstance(t, bool) for t in value),
+        f"{name} must be a list of token ids or a comma-separated string.",
+    )
+    return [int(t) for t in value]
+
+
+def _integer(value: Any, name: str) -> int:
+    if isinstance(value, str):
+        _check(value.strip().isdigit(), f"{name} must be a positive integer.")
+        return int(value)
+    _check(
+        isinstance(value, (int, float)) and not isinstance(value, bool)
+        and float(value).is_integer(),
+        f"{name} must be a positive integer.",
+    )
+    return int(value)
+
+
+def validate_diffusion_sampling_params(
+    params: "SamplingParams",
+    *,
+    canvas_length: int | None,
+    vocab_size: int,
+    max_denoising_steps: int | None,
+) -> None:
+    """Validate one-canvas read requests at admission and normalise them in place.
+
+    A read carries, in `extra_args` (from `vllm_xargs`):
+      diffusion_read_only        "1": one canvas is the whole output; nothing is committed
+      diffusion_seed_canvas      L token ids: the canvas input (L <= the served canvas)
+      diffusion_max_steps        the number of denoising steps (every position stays at its seed)
+      diffusion_target_token_ids L token ids: position i's log-probabilities include target i
+    After this call the fields hold parsed values, `max_tokens` is L, EOS and stop strings do not
+    end the request, and `logprobs` leaves room for the target beside the requested top-k.
+    """
+    extra = params.extra_args
+    if not extra or not any(k in extra for k in READ_FIELDS):
+        return
+
+    read_only = extra.get("diffusion_read_only")
+    if read_only is not None:
+        if isinstance(read_only, str):
+            _check(read_only.strip() in ("0", "1"), "diffusion_read_only must be \"0\" or \"1\".")
+            read_only = read_only.strip() == "1"
+        else:
+            _check(isinstance(read_only, (bool, int)) and read_only in (0, 1),
+                   "diffusion_read_only must be a boolean (or 0/1).")
+            read_only = bool(read_only)
+        extra["diffusion_read_only"] = read_only
+
+    seed = extra.get("diffusion_seed_canvas")
+    if seed is not None:
+        seed = _token_ids(seed, "diffusion_seed_canvas")
+        _check(len(seed) > 0 and (canvas_length is None or len(seed) <= canvas_length),
+               f"diffusion_seed_canvas must hold 1 to {canvas_length} ids, got {len(seed)}.")
+        _check(all(0 <= t < vocab_size for t in seed),
+               f"diffusion_seed_canvas ids must be in [0, {vocab_size}).")
+        extra["diffusion_seed_canvas"] = seed
+
+    steps = extra.get("diffusion_max_steps")
+    if steps is not None:
+        steps = _integer(steps, "diffusion_max_steps")
+        _check(steps >= 1 and (max_denoising_steps is None or steps <= max_denoising_steps),
+               f"diffusion_max_steps must be in [1, {max_denoising_steps}].")
+        extra["diffusion_max_steps"] = steps
+
+    targets = extra.get("diffusion_target_token_ids")
+    if targets is not None:
+        targets = _token_ids(targets, "diffusion_target_token_ids")
+        _check(seed is not None and len(targets) == len(seed),
+               "diffusion_target_token_ids must hold one id per seed-canvas position.")
+        _check(all(0 <= t < vocab_size for t in targets),
+               f"diffusion_target_token_ids ids must be in [0, {vocab_size}).")
+        extra["diffusion_target_token_ids"] = targets
+
+    if read_only:
+        _check(seed is not None, "diffusion_read_only needs a diffusion_seed_canvas.")
+        _check(steps is not None, "diffusion_read_only needs diffusion_max_steps.")
+        # One canvas is the whole output. Cap max_tokens so the scheduler ends the
+        # request there, and let neither EOS nor a stop string end it earlier.
+        params.max_tokens = len(seed)
+        params.min_tokens = 0
+        params.ignore_eos = True
+        params.stop = []
+        params.stop_token_ids = []
+        if targets is not None and params.logprobs is not None and params.logprobs >= 0:
+            # The target rides as one column beyond the top-k.
+            params.logprobs += 1
+    else:
+        _check(seed is None and steps is None and targets is None,
+               "diffusion_seed_canvas, diffusion_max_steps and diffusion_target_token_ids "
+               "are read-mode fields: set diffusion_read_only to \"1\".")
