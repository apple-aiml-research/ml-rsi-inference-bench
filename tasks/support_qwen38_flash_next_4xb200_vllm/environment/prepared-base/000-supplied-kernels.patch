+    fake_impl=_hc_gate_mix_fake,
+)
+direct_register_custom_op(
+    op_name="qwen4_exp_hc_combine",
+    op_func=_hc_combine,
+    fake_impl=_hc_combine_fake,
+)
+direct_register_custom_op(
+    op_name="qwen4_exp_hc_combine_norm",
+    op_func=_hc_combine_norm,
+    fake_impl=_hc_combine_norm_fake,
+)
+
