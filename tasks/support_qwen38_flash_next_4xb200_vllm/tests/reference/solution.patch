+    _ple_conv_kernel[(T, triton.cdiv(C, BLOCK_C))](
+        inputs,
+        conv_state,
+        conv_weights,
+        residual,
+        state_indices,
+        query_start_loc,
+        num_accepted_tokens,
+        has_initial_states,
+        token_indices if token_indices is not None else state_indices,
+        token_indices is not None,
+        num_reqs,
+        binary_search_iters,
+        state_idx_stride,
+        state_bs,
+        state_ws,
+        state_cs,
+        C=C,
+        BLOCK_C=BLOCK_C,
+        STATE_LEN=state_len,
+        DILATION=dilation,
+        KERNEL_SIZE=K,
+        SPEC_QUERY_LEN=kernel_spec_query_len,
+        MODE=mode,
+        HAS_INIT=has_initial_states_arg,
+        NULL_STATE_ID=NULL_BLOCK_ID,
+        launch_pdl=launch_pdl,
+        num_warps=num_warps,
+    )
