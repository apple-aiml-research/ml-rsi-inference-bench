+        # Kernel-visible pages with --block-size 256 and hybrid-cache alignment.
+        pytest.param(1, 24, 2, 1792, id="tp1_split64"),
+        pytest.param(16, 12, 1, 1792, id="tp2_split32"),
+        pytest.param(32, 6, 1, 1024, id="tp4_split8"),
