+  dispatch_inkling_gate_topk_renorm_v2<false>(
+      static_cast<const float*>(logits.data_ptr()),
+      static_cast<const float*>(bias.data_ptr()),
+      static_cast<const float*>(global_scale.data_ptr()),
+      static_cast<float*>(routed_w.data_ptr()),
