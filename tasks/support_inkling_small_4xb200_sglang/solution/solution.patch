diff --git a/inkling_rel_attention.py b/inkling_rel_attention.py
new file mode 100644
index 0000000000000000000000000000000000000000..475252077e3461d85cbcb94f6643cd5f45db4551
--- /dev/null
+++ b/inkling_rel_attention.py
@@ -0,0 +1,83 @@
+"""Relative-attention operator contract: the reference's adapter.
+
+The contract (eval/inkling_small/rel_attention/README.md) fixes one callable, ``relative_attention``,
+with the ragged and paged key forms. This adapter serves it with the model's served kernels: it calls
+the engine's FlashAttention-4 entry points exactly as the engine's FlashAttention backend calls them
+for this model on SM100 at the recipe's defaults, the ragged form through ``flash_attn_varlen_func``
+and the paged form through ``flash_attn_with_kvcache`` (the pool viewed ``[pages, 128, 2, 128]``),
+with ``ver=4``, ``rel_bias``, the backend's split heuristic (``num_splits=0``), ``causal=True`` and the
+backend's window form: ``(511, 0)`` on sliding-window layers and ``(-1, -1)`` on full layers.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from sglang.jit_kernel.flash_attention import flash_attn_varlen_func, flash_attn_with_kvcache
+
+
+def _backend_window(window_size) -> tuple[int, int]:
+    left, right = window_size
+    if left is None and right is None:
+        return (-1, -1)
+    return (int(left), int(right))
+
+
+def relative_attention(
+    q,
+    k,
+    v,
+    rel_bias,
+    cu_seqlens_q,
+    max_seqlen_q,
+    *,
+    cu_seqlens_k=None,
+    max_seqlen_k=None,
+    page_table=None,
+    seqused_k=None,
+    causal=True,
+    window_size=(None, None),
+    softmax_scale,
+    out=None,
+) -> torch.Tensor:
+    if not causal:
+        raise ValueError("relative_attention: the contract is causal")
+    window = _backend_window(window_size)
+    if page_table is not None:
+        result = flash_attn_with_kvcache(
+            q=q,
+            k_cache=k,
+            v_cache=v,
+            page_table=page_table,
+            cache_seqlens=seqused_k,
+            cu_seqlens_q=cu_seqlens_q,
+            max_seqlen_q=max_seqlen_q,
+            softmax_scale=softmax_scale,
+            causal=True,
+            window_size=window,
+            num_splits=0,
+            rel_bias=rel_bias,
+            ver=4,
+        )
+    else:
+        result = flash_attn_varlen_func(
+            q=q,
+            k=k,
+            v=v,
+            cu_seqlens_q=cu_seqlens_q,
+            cu_seqlens_k=cu_seqlens_k,
+            max_seqlen_q=max_seqlen_q,
+            max_seqlen_k=max_seqlen_k,
+            softmax_scale=softmax_scale,
+            causal=True,
+            window_size=window,
+            num_splits=0,
+            rel_bias=rel_bias,
+            ver=4,
+        )
+    if isinstance(result, tuple):
+        result = result[0]
+    if out is not None:
+        out.copy_(result)
+        return out
+    return result
