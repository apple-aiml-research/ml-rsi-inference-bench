+                nb, bs = 48, 384
+            elif t <= 256:
+                nb, bs = 80, 384
+            elif t <= 512:
+                nb, bs = 192, 768
+            elif t <= 768:
+                nb, bs = 96, 512
+            elif t <= 1024:
+                nb, bs = 96, 768
+            elif t <= 1536:
+                nb, bs = 192, 768
+            else:
+                nb, bs = 148, 1024
+        elif 8192 <= t < 10240:
