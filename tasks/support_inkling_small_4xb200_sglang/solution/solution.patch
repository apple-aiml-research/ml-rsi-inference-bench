+        seq_lens,
+        seq_lens.stride(0),
+        extend_seq_lens,
+        extend_seq_lens.stride(0),
+        req_to_token,
+        req_to_token.stride(0),
+        req_to_token.stride(1),
+        req_pool_indices,
+        req_pool_indices.stride(0),
+        cache_seqlens_int32,
+        cache_seqlens_int32.stride(0),
+        cu_seqlens_k,
+        cu_seqlens_k.stride(0),
+        cu_seqlens_q,
+        cu_seqlens_q.stride(0),
+        page_table,
+        page_table.stride(0),
+        page_table.stride(1),
+        full_to_swa_index_mapping,
+        swa_page_table,
+        out_cache_loc,
+        swa_out_cache_loc,
+        batch_size,
+        max_seq_pages,
+        tokens_per_req,
+        PAGE_SIZE_ONE=page_size == 1,
+        SHIFT=(page_size).bit_length() - 1 if page_size > 1 else 0,
+        BLOCK_COLS=BLOCK_COLS,
+        num_warps=8,
+        num_stages=3,
+        HAS_SWA=has_swa,
+        OUT_BLOCK=out_block,
+    )
+
+
