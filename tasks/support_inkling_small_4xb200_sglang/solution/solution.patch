+def gemm_blockscaled(
+    tiled_mma: cute.TiledMma,
+    acc: cute.Tensor,
+    tCrA: cute.Tensor,
+    tCrB: cute.Tensor,
+    tCtSFA: cute.Tensor,
+    tCtSFB: cute.Tensor,
