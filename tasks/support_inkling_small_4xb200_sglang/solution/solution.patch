+        self.sched_stages = 1
+        if self.use_clc_scheduler:
+            assert (
+                self.cluster_shape_mn[1] == 1
+            ), f"CLC requires cluster N == 1: {self.cluster_shape_mn}"
+            assert self.cluster_shape_mn[0] in (
+                1,
+                2,
