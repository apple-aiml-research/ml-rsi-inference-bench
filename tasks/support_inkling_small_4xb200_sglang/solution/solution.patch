+
+@pytest.mark.skipif(
+    not _CUDA_BF16_AVAILABLE,
+    reason="multi-prefill parity requires a CUDA GPU with BF16 tensor cores",
+)
+@pytest.mark.parametrize(
+    ("num_slots", "num_tokens"), [(2, 33), (3, 64), (4, 65), (5, 33), (8, 64), (16, 65)]
