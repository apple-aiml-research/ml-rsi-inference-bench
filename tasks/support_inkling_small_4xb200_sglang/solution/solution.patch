+    # cache, so PDL does not belong in the compile key.
+    use_pdl = is_arch_support_pdl()
+    compile_key = (
+        dtype,
+        dtype_partial,
+        head_dim,
+        tile_m,
+        k_block_size,
+        log_max_splits,
+        cu_seqlens is not None,
+        seqused is not None,
+        lse is not None,
+        varlen_batch_idx is not None,
+    )
