+            if mX is not None
+            else None
+            for mX in (mQ, mQv, mO, mP)
+        ]
+        mK, mV = [
+            cute.make_tensor(mX.iterator, cute.select(mX.layout, mode=KV_layout_transpose))
+            if mX is not None
+            else None
+            for mX in (mK, mV)
+        ]
