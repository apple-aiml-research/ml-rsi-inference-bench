   "operation": "supplied: the two sparse registrations become import-safe pybind11 callables raising NotImplementedError, the sparse headers' includes are removed; reference: unchanged",
   "supplied": {
    "includes_old": "#include \"sparse_fwd.h\"\n#include \"sparse_decode.h\"\n#include \"dense_decode.h\"\n#include \"dense_fwd.h\"\n",
    "includes_new": "#include \"dense_decode.h\"\n#include \"dense_fwd.h\"\n\n// Inference-Bench (the DeepSeek-V4 kernel/state revision): the optimized sparse attention implementation is not\n// supplied in this starting tree. The two sparse entry points stay registered, so the extension imports, and raise\n// NotImplementedError when called; their contract is /app/eval/deepseek_v4_flash/kernels/README.md.\nnamespace {\n[[noreturn]] void infb_sparse_unavailable(const char *name) {\n    PyErr_Format(PyExc_NotImplementedError,\n                 \"flash_mla.cuda.%s: the sparse attention implementation is not supplied in this starting tree \"\n                 \"(its contract: /app/eval/deepseek_v4_flash/kernels/README.md)\", name);\n    throw pybind11::error_already_set();\n}\n}  // namespace\n",
    "registrations": [
     [
      "    m.def(\"sparse_decode_fwd\", &sparse_attn_decode_interface);\n",
      "    m.def(\"sparse_decode_fwd\", [](const pybind11::args &, const pybind11::kwargs &) { infb_sparse_unavailable(\"sparse_decode_fwd\"); });\n"
     ],
     [
      "    m.def(\"sparse_prefill_fwd\", &sparse_attn_prefill_interface);\n",
      "    m.def(\"sparse_prefill_fwd\", [](const pybind11::args &, const pybind11::kwargs &) { infb_sparse_unavailable(\"sparse_prefill_fwd\"); });\n"
     ]
    ]
   },
