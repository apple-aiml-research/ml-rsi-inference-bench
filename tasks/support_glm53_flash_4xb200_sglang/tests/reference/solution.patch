+        nn.Module.__init__(self)
+        self.norm1 = RMSNorm(dim, eps=rms_norm_eps)
+        self.norm2 = RMSNorm(dim, eps=rms_norm_eps)
+        self.attn = VisionAttention(
+            embed_dim=dim,
