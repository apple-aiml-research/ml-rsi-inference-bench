+@torch.compile
+def swiglu_clamped(y: torch.Tensor, limit: float):
+    gate, up = torch.chunk(y, 2, dim=-1)
+    gate = torch.clamp(gate, max=limit)
+    up = torch.clamp(up, min=-limit, max=limit)
+    return F.silu(gate) * up
+
+
+class Glm5NextVisionMLP(GlmOcrVisionMLP):
+    def __init__(
+        self,
+        in_features: int,
+        hidden_features: int,
+        swiglu_limit: float,
+        bias: bool = False,
+        quant_config: Optional[QuantizationConfig] = None,
+        prefix: str = "",
+        use_data_parallel: bool = False,
+    ):
+        super().__init__(
+            in_features=in_features,
+            hidden_features=hidden_features,
+            bias=bias,
+            quant_config=quant_config,
+            prefix=prefix,
+            use_data_parallel=use_data_parallel,
+        )
+        self.swiglu_limit = swiglu_limit
+
+    def forward(self, x: torch.Tensor):
+        gate_up, _ = self.gate_up_proj(x)
+        x = swiglu_clamped(gate_up, self.swiglu_limit)
+        x, _ = self.down_proj(x)
+        return x
+
+
+class Glm5NextVisionPatchMerger(GlmOcrVisionPatchMerger):
+    def __init__(
+        self,
+        d_model: int,
+        context_dim: int,
+        swiglu_limit: float,
+        quant_config: Optional[QuantizationConfig] = None,
+        bias: bool = False,
+        prefix: str = "",
+        use_data_parallel: bool = False,
+    ) -> None:
+        super().__init__(
+            d_model=d_model,
+            context_dim=context_dim,
+            quant_config=quant_config,
+            bias=bias,
+            prefix=prefix,
+            use_data_parallel=use_data_parallel,
+        )
+        self.swiglu_limit = swiglu_limit
+
+    def forward(self, x: torch.Tensor):
+        x, _ = self.proj(x)
+        x = self.extra_activation_func(self.post_projection_norm(x))
+        gate_up, _ = self.gate_up_proj(x)
+        x = swiglu_clamped(gate_up, self.swiglu_limit)
+        x, _ = self.down_proj(x)
+        return x
+
